---
import Layout from '../../layouts/Layout.astro';
import Testimonials from '../../components/Testimonials.astro';
import HeroGraphic from '../../components/HeroGraphic.astro';
import Icon from '../../components/Icon.astro';
import { organizationSchema } from '../../lib/schema';
import { fetchGoogleReviews } from '../../lib/googleReviews';

const reviews = await fetchGoogleReviews('en');
const orgSchema = organizationSchema(
  reviews ? { rating: reviews.overallRating, reviewCount: reviews.totalReviewCount } : undefined
);

const features = [
  { icon: 'certificate' as const, title: 'TVTC-accredited', text: 'Verifiable accreditation, not a marketing claim.' },
  { icon: 'instructor' as const, title: 'Named instructors', text: 'Real credentialed teachers, not an anonymous "our team."' },
  { icon: 'calendar' as const, title: 'Structured levels', text: 'A clear A1→C2 path, so you always know where you stand.' },
  { icon: 'tag' as const, title: 'Transparent pricing', text: 'Price and duration published up front, on every course.' },
];

const stats = [
  { value: '15,000+', label: 'students taught' },
  { value: '9+', label: 'course programs' },
  { value: '2010', label: 'founded' },
];
---

<Layout
  locale="en"
  path="/"
  title="ELC — English Language Courses in Saudi Arabia"
  description="Accredited English courses for kids, adults, and business. Book a free placement test."
  jsonLd={orgSchema}
>
  <section class="hero zone-ink">
    <div class="hero-inner hero-animate container">
      <span class="eyebrow editorial-mark">TVTC-Accredited · Est. 2010</span>
      <h1 class="hero-headline">Learn English<br />with confidence.</h1>
      <p class="lead">
        From beginner to fluent — structured courses for kids, adults, and businesses,
        taught by named, credentialed instructors.
      </p>
      <div class="hero-actions">
        <a href="/en/register" class="btn btn-primary">Book a Placement Test</a>
        <a href="/en/courses" class="btn btn-outline">Browse courses</a>
      </div>
    </div>

    <div class="hero-graphic-wrap" aria-hidden="false">
      <HeroGraphic locale="en" tone="ink" />
    </div>

    <div class="hero-stats container">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat-value numeric">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <hr class="fluency-rule" />

  <section class="container features">
    {features.map((f) => (
      <div class="feature">
        <span class="feature-icon"><Icon name={f.icon} /></span>
        <h2>{f.title}</h2>
        <p>{f.text}</p>
      </div>
    ))}
  </section>

  <section class="container">
    <h2>Courses</h2>
    <p>Kids · Adults · Business English · Exam Prep.</p>
    <a href="/en/courses" class="btn btn-outline">Browse all courses</a>
  </section>

  <div class="container">
    <Testimonials locale="en" data={reviews} />
  </div>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-8) var(--space-6);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    text-align: start;
  }
  .eyebrow {
    display: inline-block;
    font-size: var(--fs-lg);
    color: var(--zone-ink-signal);
    margin-bottom: var(--space-3);
  }
  .hero-headline {
    font-size: var(--fs-3xl);
    margin-bottom: var(--space-4);
  }
  .lead { font-size: var(--fs-lg); max-width: 38ch; margin-bottom: var(--space-5); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .hero-graphic-wrap {
    position: absolute;
    inset-inline-end: -3rem;
    top: 50%;
    transform: translateY(-58%);
    width: min(30rem, 42vw);
    opacity: 0.9;
    pointer-events: none;
  }

  .hero-stats {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--zone-ink-border);
  }
  .stat { display: flex; flex-direction: column; }
  .stat-value { font-size: var(--fs-xl); font-weight: 700; color: var(--zone-ink-text); }
  .stat-label { color: var(--zone-ink-muted); font-size: var(--fs-sm); }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .feature { display: flex; flex-direction: column; gap: var(--space-1); }
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-crimson-text);
    margin-bottom: var(--space-1);
  }
  .feature h2 { font-size: var(--fs-base); margin: 0; }
  .feature p { margin: 0; color: var(--color-ink-muted); font-size: var(--fs-sm); }

  @media (max-width: 780px) {
    .hero-graphic-wrap { position: static; width: 14rem; margin: var(--space-5) auto 0; opacity: 1; transform: none; }
    .hero-inner { max-width: none; }
  }
</style>
