---
import Layout from '../../layouts/Layout.astro';
import Testimonials from '../../components/Testimonials.astro';
import HeroGraphic from '../../components/HeroGraphic.astro';
import Icon from '../../components/Icon.astro';
import { organizationSchema } from '../../lib/schema';
import { fetchGoogleReviews } from '../../lib/googleReviews';

const reviews = await fetchGoogleReviews('en');
const orgSchema = organizationSchema(
  reviews ? { rating: reviews.overallRating, reviewCount: reviews.totalReviewCount } : undefined
);

const features = [
  { icon: 'certificate' as const, title: 'TVTC-accredited', text: 'Verifiable accreditation, not a marketing claim.' },
  { icon: 'instructor' as const, title: 'Named instructors', text: 'Real credentialed teachers, not an anonymous "our team."' },
  { icon: 'calendar' as const, title: 'Structured levels', text: 'A clear A1→C2 path, so you always know where you stand.' },
  { icon: 'tag' as const, title: 'Transparent pricing', text: 'Price and duration published up front, on every course.' },
];
---

<Layout
  locale="en"
  path="/"
  title="ELC — English Language Courses in Saudi Arabia"
  description="Accredited English courses for kids, adults, and business. Book a free placement test."
  jsonLd={orgSchema}
>
  <section class="hero container">
    <div class="hero-text">
      <span class="eyebrow">TVTC-Accredited · Since [year]</span>
      <h1>Learn English with confidence, at every level.</h1>
      <p class="lead">
        From beginner to fluent — structured courses for kids, adults, and businesses,
        taught by named, credentialed instructors.
      </p>
      <a href="/en/register" class="btn btn-primary">Book a Placement Test</a>
    </div>
    <div class="hero-visual">
      <HeroGraphic locale="en" />
    </div>
  </section>

  <section class="container features">
    {features.map((f) => (
      <div class="feature">
        <span class="feature-icon"><Icon name={f.icon} /></span>
        <h2>{f.title}</h2>
        <p>{f.text}</p>
      </div>
    ))}
  </section>

  <section class="container">
    <h2>Courses</h2>
    <p>Kids · Adults · Business English · Exam Prep.</p>
    <a href="/en/courses" class="btn btn-outline">Browse all courses</a>
  </section>

  <div class="container">
    <Testimonials locale="en" data={reviews} />
  </div>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }
  .hero-text { text-align: start; }
  .hero-visual { display: flex; justify-content: center; }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-amber-text);
  }
  .lead { font-size: var(--fs-lg); color: var(--color-ink-muted); max-width: 40ch; }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .feature { display: flex; flex-direction: column; gap: var(--space-1); }
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-crimson-text);
    margin-bottom: var(--space-1);
  }
  .feature h2 { font-size: var(--fs-base); margin: 0; }
  .feature p { margin: 0; color: var(--color-ink-muted); font-size: var(--fs-sm); }

  @media (max-width: 780px) {
    .hero { grid-template-columns: 1fr; }
    .hero-visual { order: -1; max-width: 220px; margin-inline: auto; }
  }
</style>
