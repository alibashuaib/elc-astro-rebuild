---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import RegistrationExperience from '../../components/RegistrationExperience.astro';
import { breadcrumbSchema } from '../../lib/schema';

const courses = await getCollection('courses', (e) => e.id.startsWith('en/') && !e.data.draft);

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: 'https://elc.com.sa/en/' },
  { name: 'Register', url: 'https://elc.com.sa/en/register' },
]);
---

<Layout
  locale="en"
  path="/register"
  title="Register — ELC English Courses in Jeddah"
  description="Enroll at ELC in Jeddah or book a free English placement test. Fast registration for kids, adults, and business English courses."
  jsonLd={breadcrumbs}
>
  <PageHero title="Register" subtitle="Streamlined enrollment — book your spot or a free placement test." />

  <RegistrationExperience locale="en" courses={courses} />
</Layout>
