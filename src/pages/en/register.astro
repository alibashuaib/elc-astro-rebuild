---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { breadcrumbSchema } from '../../lib/schema';

const courses = await getCollection('courses', (e) => e.id.startsWith('en/') && !e.data.draft);

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: 'https://elc.com.sa/en/' },
  { name: 'Register', url: 'https://elc.com.sa/en/register' },
]);
---

<Layout
  locale="en"
  path="/register"
  title="Register — ELC"
  description="Enroll at ELC or book a free placement test."
  jsonLd={breadcrumbs}
>
  <section class="container prose-page">
    <h1>Register</h1>
    <p>Streamlined enrollment — a real backend/CRM hookup is a later step; this form posts to a placeholder endpoint for now.</p>

    <form class="register-form" method="POST" action="/api/register">
      <label>
        Full name
        <input type="text" name="name" required />
      </label>
      <label>
        Email
        <input type="email" name="email" required />
      </label>
      <label>
        Phone / WhatsApp
        <input type="tel" name="phone" required />
      </label>
      <label>
        Course
        <select name="course" required>
          <option value="">Select a course</option>
          {courses.map((c) => (
            <option value={c.id.replace('en/', '')}>{c.data.title}</option>
          ))}
        </select>
      </label>
      <button type="submit" class="btn btn-primary">Submit registration</button>
    </form>
  </section>
</Layout>

<style>
  .prose-page { padding-block: var(--space-6); max-width: 32rem; }
  .register-form { display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-4); }
  .register-form label { display: flex; flex-direction: column; gap: var(--space-1); font-weight: 600; }
  .register-form input, .register-form select {
    font: inherit;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-raised);
    color: var(--color-ink);
  }
</style>
