---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { breadcrumbSchema } from '../../lib/schema';

const criteria = [
  'Verifiable accreditation (TVTC)',
  'Named, credentialed instructors — not anonymous "expert teachers"',
  'Structured curriculum with a visible CEFR level path (A1→C2)',
  'Transparent pricing and duration, published up front',
];

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: 'https://elc.com.sa/en/' },
  { name: 'Why ELC', url: 'https://elc.com.sa/en/why-elc' },
]);
---

<Layout
  locale="en"
  path="/why-elc"
  title="Why ELC — What Makes Us Different"
  description="How ELC compares on accreditation, class structure, and outcomes — for learners weighing their options."
  jsonLd={breadcrumbs}
>
  <PageHero
    title="Why ELC"
    subtitle="For anyone weighing a few language centers before enrolling — compared on facts, not by disparaging alternatives."
  />

  <section class="container prose-page">
    <h2>What to look for in a language center</h2>
    <ul class="criteria-list">
      {criteria.map((item) => (
        <li><Icon name="check" size={18} /><span>{item}</span></li>
      ))}
    </ul>

    <h2>Where ELC stands on each</h2>
    <p>Placeholder — fill in with real, specific comparisons once available.</p>
  </section>
</Layout>

<style>
  .prose-page { padding-block: var(--space-6); max-width: 42rem; }
  .criteria-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .criteria-list li { display: flex; align-items: flex-start; gap: var(--space-2); }
  .criteria-list :global(svg) { color: var(--color-crimson-text); flex-shrink: 0; margin-top: 0.15em; }
</style>
