---
import Layout from '../../layouts/Layout.astro';
import AboutExperience from '../../components/AboutExperience.astro';
import { organizationSchema, breadcrumbSchema } from '../../lib/schema';

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: 'https://elc.com.sa/en/' },
  { name: 'About ELC', url: 'https://elc.com.sa/en/about' },
]);
---

<Layout
  locale="en"
  path="/about"
  title="About ELC — Why Learn With Us"
  description="Meet ELC and discover why learners choose our TVTC-accredited programs, qualified teachers, modern classrooms, and goal-focused curricula."
  jsonLd={[organizationSchema(), breadcrumbs]}
>
  <AboutExperience locale="en" />
</Layout>
