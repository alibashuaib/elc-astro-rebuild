---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { organizationSchema, breadcrumbSchema } from '../../lib/schema';

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: 'https://elc.com.sa/en/' },
  { name: 'About', url: 'https://elc.com.sa/en/about' },
]);

// Real content pulled from the live elc.com.sa "About Us" page — replaces the
// old placeholder copy. Instructor block still can't be fully fixed (see below):
// the live site names no individual instructors, only qualification types.
const blocks = [
  {
    icon: 'certificate' as const,
    title: 'Accreditation',
    text: 'TVTC-accredited since our founding in 2010. Certificates are recognized within Saudi Arabia and accepted by educational institutions and employers. TODO: link the verifiable TVTC record once available.',
  },
  {
    icon: 'building' as const,
    title: 'Facilities',
    text: 'Dedicated sections for children and for female students, classrooms equipped with modern technology and projectors, a reading library, an indoor cafeteria, supplementary support hours, and transportation services. Real photography still needed (plan §8).',
  },
  {
    icon: 'instructor' as const,
    title: 'Instructors',
    text: 'Teachers hold internationally recognized certifications — CELTA, TESOL, DELTA, or equivalent — and take part in ongoing training. TODO: this still doesn\'t fix the audit\'s "no named instructors" gap — individual names, photos, and credentials aren\'t published on the current site either, and need to be collected.',
  },
];

const mission = 'Provide high-quality English language education that empowers learners to achieve their academic and professional aspirations.';
const stats = [
  { value: '15,000+', label: 'students taught' },
  { value: '9+', label: 'course programs' },
  { value: '2010', label: 'founded' },
];
---

<Layout
  locale="en"
  path="/about"
  title="About ELC"
  description="ELC is a TVTC-accredited English language center. Learn about our accreditation, facilities, and instructors."
  jsonLd={[organizationSchema(), breadcrumbs]}
>
  <PageHero title="About ELC" subtitle={mission} />

  <section class="container prose-page">
    <div class="stats-row">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat-value numeric">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>

    <div class="about-grid">
      {blocks.map((b) => (
        <div class="about-block">
          <span class="block-icon"><Icon name={b.icon} size={28} /></span>
          <h2>{b.title}</h2>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .prose-page { padding-block: var(--space-6); }
  .stats-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: 0 0 var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .stat { display: flex; flex-direction: column; }
  .stat-value { font-size: var(--fs-xl); font-weight: 700; color: var(--color-crimson-text); }
  .stat-label { color: var(--color-ink-muted); font-size: var(--fs-sm); }
  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
    max-width: 60rem;
  }
  .about-block {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-raised);
  }
  .block-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-crimson-text);
    margin-bottom: var(--space-3);
  }
  .about-block h2 { font-size: var(--fs-lg); margin: 0 0 var(--space-2); }
  .about-block p { margin: 0; color: var(--color-ink-muted); }
</style>
