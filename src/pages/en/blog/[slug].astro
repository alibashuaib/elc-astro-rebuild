---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { breadcrumbSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.id.startsWith('en/'));
  return posts.map((post) => ({
    params: { slug: post.id.replace('en/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(post);
const { title, summary, publishDate } = post.data;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  datePublished: publishDate.toISOString(),
  author: { '@type': 'Organization', name: 'ELC' },
};

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: 'https://elc.com.sa/en/' },
  { name: 'News', url: 'https://elc.com.sa/en/blog' },
  { name: title, url: `https://elc.com.sa/en/blog/${slug}` },
]);
---

<Layout
  locale="en"
  path={`/blog/${slug}`}
  title={`${title} — ELC`}
  description={summary}
  jsonLd={[articleSchema, breadcrumbs]}
>
  <article class="container prose-page">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/en/">Home</a> / <a href="/en/blog">News</a> / <span>{title}</span>
    </nav>
    <h1>{title}</h1>
    <time datetime={publishDate.toISOString()} class="numeric">
      {publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .prose-page { padding-block: var(--space-6); max-width: 42rem; }
  .breadcrumb { font-size: var(--fs-sm); color: var(--color-ink-muted); margin-bottom: var(--space-3); }
  time { color: var(--color-ink-muted); font-size: var(--fs-sm); display: block; margin-bottom: var(--space-4); }
</style>
