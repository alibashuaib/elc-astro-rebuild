---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import NewsExperience from '../../../components/NewsExperience.astro';
import { breadcrumbSchema } from '../../../lib/schema';

const posts = (await getCollection('blog', (e) => e.id.startsWith('en/') && !e.data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: 'https://elc.com.sa/en/' },
  { name: 'News', url: 'https://elc.com.sa/en/blog' },
]);
---

<Layout
  locale="en"
  path="/blog"
  title="News — ELC"
  description="Articles, tips, and updates from ELC."
  jsonLd={breadcrumbs}
>
  <PageHero title="News" subtitle="Articles, tips, and updates from ELC." />

  <NewsExperience locale="en" posts={posts} />
</Layout>
