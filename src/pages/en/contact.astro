---
import Layout from '../../layouts/Layout.astro';
import ContactExperience from '../../components/ContactExperience.astro';
import { breadcrumbSchema } from '../../lib/schema';

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: 'https://elc.com.sa/en/' },
  { name: 'Contact', url: 'https://elc.com.sa/en/contact' },
]);
---

<Layout
  locale="en"
  path="/contact"
  title="Contact ELC in Jeddah"
  description="Call, WhatsApp, email, or visit ELC in Jeddah for English course information, placement testing, and registration support."
  jsonLd={breadcrumbs}
>
  <ContactExperience locale="en" />
</Layout>
