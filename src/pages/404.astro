---
// A single bilingual page (not per-locale) — Apache's ErrorDocument directive
// can only point at one path, and we don't know which language the visitor
// expected from a broken/old URL, so show both rather than guessing.
import { Image } from 'astro:assets';
import logoFull from '../assets/logo-elc-full.png';
import '../styles/global.css';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found — ELC / الصفحة غير موجودة</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
  </head>
  <body>
    <main class="not-found">
      <a href="/en/" class="logo" aria-label="ELC homepage">
        <Image src={logoFull} alt="ELC — English Learning Centre" width={112} densities={[1, 2]} />
      </a>

      <p class="code" aria-hidden="true">404</p>

      <div class="block">
        <h1>Page not found</h1>
        <p>The page you're looking for doesn't exist or may have moved.</p>
        <a class="btn btn-primary" href="/en/">Go to homepage</a>
      </div>

      <hr />

      <div class="block" dir="rtl" lang="ar">
        <h1>الصفحة غير موجودة</h1>
        <p>الصفحة التي تبحث عنها غير موجودة أو تم نقلها.</p>
        <a class="btn btn-primary" href="/ar/">الذهاب إلى الصفحة الرئيسية</a>
      </div>
    </main>
  </body>
</html>

<style>
  .not-found {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-4);
    text-align: center;
    background: var(--color-bg);
  }
  .logo { display: inline-flex; margin-bottom: var(--space-2); }
  .logo :global(img) { display: block; width: 7rem; height: auto; }
  .code {
    margin: 0;
    color: var(--color-border-strong);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 850;
    line-height: 1;
    letter-spacing: -.04em;
  }
  .block { max-width: 32rem; }
  .block h1 { margin: 0 0 .5rem; color: var(--color-navy); font-size: clamp(1.4rem, 3vw, 1.8rem); }
  .block p { margin: 0 0 var(--space-3); color: var(--color-ink-muted); }
  hr { width: 100%; max-width: 20rem; margin: var(--space-2) 0; border: none; border-top: 1px solid var(--color-border); }
</style>
