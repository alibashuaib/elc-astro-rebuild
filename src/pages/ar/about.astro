---
import Layout from '../../layouts/Layout.astro';
import AboutExperience from '../../components/AboutExperience.astro';
import { organizationSchema, breadcrumbSchema } from '../../lib/schema';

const breadcrumbs = breadcrumbSchema([
  { name: 'الرئيسية', url: 'https://elc.com.sa/ar/' },
  { name: 'من نحن', url: 'https://elc.com.sa/ar/about' },
]);
---

<Layout
  locale="ar"
  path="/about"
  title="من نحن ولماذا معهد صرح المعرفة"
  description="تعرّف على معهد صرح المعرفة واكتشف لماذا يختار المتعلمون برامجنا المعتمدة ومدرّبينا المؤهلين وبيئتنا التعليمية الحديثة ومناهجنا المصممة لأهدافهم."
  jsonLd={[organizationSchema(undefined, 'ar'), breadcrumbs]}
>
  <AboutExperience locale="ar" />
</Layout>
