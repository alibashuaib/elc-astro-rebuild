---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import RegistrationExperience from '../../components/RegistrationExperience.astro';
import { breadcrumbSchema } from '../../lib/schema';

const courses = await getCollection('courses', (e) => e.id.startsWith('ar/') && !e.data.draft);

const breadcrumbs = breadcrumbSchema([
  { name: 'الرئيسية', url: 'https://elc.com.sa/ar/' },
  { name: 'التسجيل', url: 'https://elc.com.sa/ar/register' },
]);
---

<Layout
  locale="ar"
  path="/register"
  title="التسجيل — معهد صرح المعرفة"
  description="سجّل في معهد صرح المعرفة أو احجز اختبار تحديد مستوى مجاني."
  jsonLd={breadcrumbs}
>
  <PageHero kicker="معهد صرح المعرفة" title="التسجيل" subtitle="تسجيل مبسّط — احجز مكانك أو اختبار تحديد مستوى مجاني." />

  <RegistrationExperience locale="ar" courses={courses} />
</Layout>
