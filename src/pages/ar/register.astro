---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { breadcrumbSchema } from '../../lib/schema';

const courses = await getCollection('courses', (e) => e.id.startsWith('ar/') && !e.data.draft);

const breadcrumbs = breadcrumbSchema([
  { name: 'الرئيسية', url: 'https://elc.com.sa/ar/' },
  { name: 'التسجيل', url: 'https://elc.com.sa/ar/register' },
]);
---

<Layout
  locale="ar"
  path="/register"
  title="التسجيل — ELC"
  description="سجّل في ELC أو احجز اختبار تحديد مستوى مجاني."
  jsonLd={breadcrumbs}
>
  <PageHero title="التسجيل" subtitle="تسجيل مبسّط — احجز مكانك أو اختبار تحديد مستوى مجاني." />

  <section class="container prose-page">
    <form class="register-form" method="POST" action="/api/register">
      <label>
        الاسم الكامل
        <input type="text" name="name" required />
      </label>
      <label>
        البريد الإلكتروني
        <input type="email" name="email" required />
      </label>
      <label>
        الهاتف / واتساب
        <input type="tel" name="phone" required />
      </label>
      <label>
        الدورة
        <select name="course" required>
          <option value="">اختر دورة</option>
          {courses.map((c) => (
            <option value={c.id.replace('ar/', '')}>{c.data.title}</option>
          ))}
        </select>
      </label>
      <button type="submit" class="btn btn-primary">إرسال التسجيل</button>
    </form>
  </section>
</Layout>

<style>
  .prose-page { padding-block: var(--space-6); max-width: 32rem; }
  .register-form { display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-4); }
  .register-form label { display: flex; flex-direction: column; gap: var(--space-1); font-weight: 600; }
  .register-form input, .register-form select {
    font: inherit;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-raised);
    color: var(--color-ink);
  }
</style>
