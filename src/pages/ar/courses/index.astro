---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import CourseCard from '../../../components/CourseCard.astro';
import CourseFilter from '../../../components/CourseFilter.astro';
import { breadcrumbSchema } from '../../../lib/schema';

const allCourses = await getCollection('courses', (entry) => {
  return entry.id.startsWith('ar/') && !entry.data.draft;
});
const categories = [...new Set(allCourses.map((c) => c.data.category))];

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'الدورات',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: allCourses.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://elc.com.sa/ar/courses/${c.id.replace('ar/', '')}`,
      name: c.data.title,
    })),
  },
};

const breadcrumbs = breadcrumbSchema([
  { name: 'الرئيسية', url: 'https://elc.com.sa/ar/' },
  { name: 'الدورات', url: 'https://elc.com.sa/ar/courses' },
]);
---

<Layout
  locale="ar"
  path="/courses"
  title="الدورات — معهد صرح المعرفة"
  description="تصفّح كتالوج دورات معهد صرح المعرفة الكامل: أطفال، كبار، إنجليزي عام للسيدات، إنجليزي أعمال، وتحضير اختبارات."
  jsonLd={[collectionPageSchema, breadcrumbs]}
>
  <PageHero kicker="معهد صرح المعرفة" title="الدورات" subtitle="اختر الدورة المناسبة حسب المستوى والمدة والسعر." />

  <section class="container">
    <CourseFilter locale="ar" categories={categories} />

    <div class="course-grid">
      {allCourses.map((course) => (
        <CourseCard locale="ar" course={course} slug={course.id.replace('ar/', '')} />
      ))}
    </div>
  </section>
</Layout>

<style>
  .container { padding-top: var(--space-5); }
  .course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
</style>
