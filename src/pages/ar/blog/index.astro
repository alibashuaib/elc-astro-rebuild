---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import NewsExperience from '../../../components/NewsExperience.astro';
import { breadcrumbSchema } from '../../../lib/schema';

const posts = (await getCollection('blog', (e) => e.id.startsWith('ar/') && !e.data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const breadcrumbs = breadcrumbSchema([
  { name: 'الرئيسية', url: 'https://elc.com.sa/ar/' },
  { name: 'الأخبار', url: 'https://elc.com.sa/ar/blog' },
]);
---

<Layout
  locale="ar"
  path="/blog"
  title="الأخبار — معهد صرح المعرفة"
  description="نصائح اختبار تحديد المستوى، وتحديثات الدورات، ونصائح تعلّم الإنجليزية من فريق معهد صرح المعرفة في جدة."
  jsonLd={breadcrumbs}
>
  <PageHero kicker="معهد صرح المعرفة" title="الأخبار" subtitle="مقالات ونصائح وتحديثات من معهد صرح المعرفة." />

  <NewsExperience locale="ar" posts={posts} />
</Layout>
