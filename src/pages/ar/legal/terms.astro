---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';

const terms = [
  'يجب دفع رسوم الدورة كاملة قبل بدء المتدرب بالدراسة.',
  'يلتزم المتدرب بأنظمة السلوك في المعهد، ويحق للمعهد إيقافه عند مخالفة السلوك.',
  'يلتزم المتدرب بالاستخدام المسؤول للأثاث والمعدات والأدوات التعليمية، وقد يتحمل تكلفة الضرر الذي يتسبب فيه.',
  'يحق للمتدرب استرداد الرسوم إذا لم تتوفر الدورة المسجل فيها أو إذا طلب الانسحاب قبل بدء الدورة بأسبوع على الأقل.',
  'عند الانسحاب خلال الأيام الخمسة الأولى من بدء الدورة، يُخصم 50٪ من رسوم تسجيل الدورة والمواصلات.',
  'لا يحق للمتدرب الانسحاب أو استرداد الرسوم بعد الأيام الخمسة الأولى من الدورة.',
  'تبلغ تكلفة الحقيبة أو المواد الدراسية البديلة 170 ريالًا سعوديًا.',
  'قد يحصل المتدرب الذي لم يجتز الدورة على خصم 50٪ لإعادتها خلال ثلاثة أشهر من تاريخ انتهائها.',
  'يلتزم المتدرب بحضور ما لا يقل عن 80٪ من الساعات الدراسية المحددة، وقد يؤثر تجاوز نسبة الغياب المسموحة في إكمال الدورة واستحقاق الشهادة.',
  'يجب استلام الشهادة خلال ثلاثة أشهر من تاريخ انتهاء الدورة.',
  'لا يحق للمتدرب المطالبة باسترداد الرسوم عند الانقطاع عن الدراسة.',
  'تخضع العودة بعد انقطاع أو إيقاف طويل لأنظمة التسجيل في المعهد وصلاحية مدة الدورة الأصلية.',
  'يجب إعادة تقييم مستوى المتدرب إذا انقطع عن الدراسة لأكثر من شهرين.',
  'عند الانسحاب من باقة ترويجية، تعود رسوم الدورات إلى السعر الأساسي خارج الباقة.',
];
---

<Layout locale="ar" path="/legal/terms" title="الشروط والأحكام — معهد صرح المعرفة" description="شروط التسجيل والحضور والانسحاب والاسترداد والشهادات لمتدربي معهد صرح المعرفة.">
  <PageHero kicker="معهد صرح المعرفة" title="الشروط والأحكام" subtitle="القواعد الحالية لرسوم الدورات والحضور والانسحاب والشهادات." />
  <section class="container legal-page">
    <p class="intro">تطبق هذه الشروط على التسجيل والدراسة في معهد صرح المعرفة. تواصل مع القبول قبل الدفع إذا احتجت إلى توضيح حول دورة أو باقة أو مواصلات أو أهلية الاسترداد.</p>
    <ol>{terms.map((term) => <li>{term}</li>)}</ol>
    <p class="contact-note">للاستفسار، اتصل على <a class="numeric" href="tel:+966591799917">059 179 9917</a> أو راسلنا عبر <a href="mailto:info@elc.com.sa">info@elc.com.sa</a>.</p>
  </section>
</Layout>

<style>
  .legal-page { max-width: 52rem; padding-block: clamp(3rem, 7vw, 6rem); }
  .intro { color: var(--color-ink-muted); font-size: 1.05rem; line-height: 1.8; }
  ol { display: grid; gap: 1rem; margin: 2rem 0; padding-inline-start: 1.5rem; }
  li { padding-inline-start: .5rem; color: var(--color-ink); line-height: 1.9; }
  li::marker { color: var(--color-primary); font-weight: 800; }
  .contact-note { padding: 1.25rem; border-radius: 1rem; color: var(--color-navy); background: var(--color-blue-soft); }
  /* Inline links in body text — underline so they don't rely on color alone
     to be distinguishable (WCAG 1.4.1), matching .breadcrumb a. */
  p a { text-decoration: underline; text-decoration-color: var(--color-border); }
  p a:hover { text-decoration-color: currentColor; }
</style>
