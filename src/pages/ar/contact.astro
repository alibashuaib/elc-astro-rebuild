---
import Layout from '../../layouts/Layout.astro';
import ContactExperience from '../../components/ContactExperience.astro';
import { breadcrumbSchema } from '../../lib/schema';

const breadcrumbs = breadcrumbSchema([
  { name: 'الرئيسية', url: 'https://elc.com.sa/ar/' },
  { name: 'اتصل بنا', url: 'https://elc.com.sa/ar/contact' },
]);
---

<Layout
  locale="ar"
  path="/contact"
  title="تواصل مع معهد صرح المعرفة في جدة"
  description="اتصل أو تواصل عبر واتساب أو البريد الإلكتروني أو زُر معهد صرح المعرفة في جدة للاستفسار عن دورات الإنجليزية واختبار تحديد المستوى والتسجيل."
  jsonLd={breadcrumbs}
>
  <ContactExperience locale="ar" />
</Layout>
