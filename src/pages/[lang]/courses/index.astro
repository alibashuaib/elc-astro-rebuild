---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import CourseCard from '../../../components/CourseCard.astro';
import CourseFilter from '../../../components/CourseFilter.astro';
import { breadcrumbSchema } from '../../../lib/schema';
import { localePaths, meta, trail, heroKicker, SITE } from '../../../i18n/pages';
import type { Locale } from '../../../i18n/ui';

export const getStaticPaths = localePaths;

const locale = Astro.params.lang as Locale;
const { title, description, hero, crumb } = meta('courses', locale);

const allCourses = await getCollection('courses', (entry) => {
  return entry.id.startsWith(`${locale}/`) && !entry.data.draft;
});
const categories = [...new Set(allCourses.map((c) => c.data.category))];

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: crumb,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: allCourses.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE}/${locale}/courses/${c.id.replace(`${locale}/`, '')}`,
      name: c.data.title,
    })),
  },
};

const breadcrumbs = breadcrumbSchema(trail(locale, ['courses']));
---

<Layout
  locale={locale}
  path="/courses"
  title={title}
  description={description}
  jsonLd={[collectionPageSchema, breadcrumbs]}
>
  <PageHero kicker={heroKicker[locale]} title={hero!.title} subtitle={hero!.subtitle} />

  <section class="container">
    <CourseFilter locale={locale} categories={categories} />

    <div class="course-grid">
      {allCourses.map((course) => (
        <CourseCard locale={locale} course={course} slug={course.id.replace(`${locale}/`, '')} />
      ))}
    </div>
  </section>
</Layout>

<style>
  .container { padding-top: var(--space-5); }
  .course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
</style>
