  .course-detail .time-icon { display: grid; width: 2.5rem; height: 2.5rem; flex: 0 0 auto; place-items: center; border-radius: .8rem; color: #fff; background: linear-gradient(135deg, var(--course-accent), var(--color-coral)); }
  .course-detail .time-card > span:last-child { display: grid; gap: .12rem; }
  .course-detail .time-card small { color: var(--color-ink-muted); font-size: .68rem; font-weight: 750; }
  .course-detail .time-card strong { color: var(--color-primary-text); font-size: clamp(1.05rem, 2vw, 1.3rem); font-weight: 900; }
  .course-detail .time-value { display: flex; align-items: baseline; gap: .35rem; }
  .course-detail .time-value > span { font-family: var(--font-body); font-size: .72em; }
  .course-detail .course-schedule > p { margin: .85rem 0 0; color: var(--color-ink-muted); font-size: .75rem; }
  @media (max-width: 620px) { .course-detail .time-grid { grid-template-columns: 1fr; } .course-detail .times-heading { align-items: flex-start; flex-direction: column; gap: .15rem; } }
</style>
