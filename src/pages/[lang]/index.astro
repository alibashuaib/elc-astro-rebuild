---
import Layout from '../../layouts/Layout.astro';
import HomeExperience from '../../components/HomeExperience.astro';
import { organizationSchema, localBusinessSchema } from '../../lib/schema';
import { fetchGoogleReviews } from '../../lib/googleReviews';
import { localePaths, meta } from '../../i18n/pages';
import type { Locale } from '../../i18n/ui';

export const getStaticPaths = localePaths;

const locale = Astro.params.lang as Locale;
const { title, description } = meta('home', locale);

const reviews = await fetchGoogleReviews(locale);
const orgSchema = organizationSchema(
  reviews ? { rating: reviews.overallRating, reviewCount: reviews.totalReviewCount } : undefined,
  locale
);

// GBP Optimization: Add LocalBusiness schema with business hours
const businessHours = [
  { day: 'Monday', open: '09:00', close: '21:00' },
  { day: 'Tuesday', open: '09:00', close: '21:00' },
  { day: 'Wednesday', open: '09:00', close: '21:00' },
  { day: 'Thursday', open: '09:00', close: '21:00' },
  { day: 'Friday', open: '09:00', close: '21:00' },
  { day: 'Saturday', open: '09:00', close: '17:00' },
];

const localSchema = localBusinessSchema(locale, businessHours);

// Use the hero image for social sharing (og:image)
const ogImage = '/images/og-home.png';
---

<Layout locale={locale} path="/" title={title} description={description} jsonLd={[orgSchema, localSchema]} ogImage={ogImage}>
  <HomeExperience locale={locale} reviews={reviews} />
</Layout>
