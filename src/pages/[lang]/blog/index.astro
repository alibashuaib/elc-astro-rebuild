---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import NewsExperience from '../../../components/NewsExperience.astro';
import { breadcrumbSchema } from '../../../lib/schema';
import { localePaths, meta, trail, heroKicker } from '../../../i18n/pages';
import type { Locale } from '../../../i18n/ui';

export const getStaticPaths = localePaths;

const locale = Astro.params.lang as Locale;
const { title, description, hero } = meta('blog', locale);

const posts = (await getCollection('blog', (e) => e.id.startsWith(`${locale}/`) && !e.data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout
  locale={locale}
  path="/blog"
  title={title}
  description={description}
  jsonLd={breadcrumbSchema(trail(locale, ['blog']))}
>
  <PageHero kicker={heroKicker[locale]} title={hero!.title} subtitle={hero!.subtitle} />

  <NewsExperience locale={locale} posts={posts} />
</Layout>
