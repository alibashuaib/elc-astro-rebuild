---
import Layout from '../../layouts/Layout.astro';
import ContactExperience from '../../components/ContactExperience.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { localePaths, meta, trail } from '../../i18n/pages';
import type { Locale } from '../../i18n/ui';

export const getStaticPaths = localePaths;

const locale = Astro.params.lang as Locale;
const { title, description } = meta('contact', locale);
---

<Layout
  locale={locale}
  path="/contact"
  title={title}
  description={description}
  jsonLd={breadcrumbSchema(trail(locale, ['contact']))}
>
  <ContactExperience locale={locale} />
</Layout>
