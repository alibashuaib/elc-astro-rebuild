---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ConsentHead from '../components/ConsentHead.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { useTranslations, localeDir, type Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  /** path without locale prefix, e.g. "/courses" — used for canonical/hreflang/lang-switch */
  path: string;
  title: string;
  description: string;
  /** optional pre-serialized JSON-LD object(s) for this page */
  jsonLd?: object | object[];
  ogImage?: string;
}

const { locale, path, title, description, jsonLd, ogImage } = Astro.props;
const t = useTranslations(locale);
const dir = localeDir[locale];

const site = Astro.site ?? new URL('https://elc.com.sa');
// Build output is directory-format (/foo/index.html, served as /foo/), and the
// sitemap already uses trailing slashes — keep canonical/hreflang matching that
// exact served URL instead of the pre-redirect /foo (Apache's DirectorySlash
// 301s it, but there's no reason to send crawlers through that extra hop).
const withTrailingSlash = (p: string) => (p === '/' ? '/' : `${p.replace(/\/$/, '')}/`);
const canonicalPath = `/${locale}${withTrailingSlash(path)}`;
const canonicalUrl = new URL(canonicalPath, site).toString();
const enUrl = new URL(`/en${withTrailingSlash(path)}`, site).toString();
const arUrl = new URL(`/ar${withTrailingSlash(path)}`, site).toString();

const ldEntries = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before first paint: apply a stored explicit theme choice. System-
         preference dark mode needs no JS (pure CSS in tokens.css) — this only
         matters for a visitor who picked a theme against their OS default,
         so their next page load doesn't flash the other one first. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('elc-theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    <!-- As early as possible: Consent Mode default (denied) + GTM, so nothing
         GTM fires ever starts in a granted state before the visitor chooses. -->
    <ConsentHead />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Bidirectional hreflang, mapped to the equivalent page, not just the homepage -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_SA' : 'en_US'} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, site).toString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preload the locale's critical local font so branded text is ready for first paint. -->
    <link
      rel="preload"
      href={locale === 'ar' ? '/fonts/alexandria-arabic.woff2' : '/fonts/manrope-latin.woff2'}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {ldEntries.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <ConsentBanner locale={locale} />
    <a href="#main" class="skip-link">{t('skip.content')}</a>
    <Header locale={locale} currentPath={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppButton label={locale === 'ar' ? 'تواصل عبر واتساب' : 'Chat on WhatsApp'} />
  </body>
</html>
