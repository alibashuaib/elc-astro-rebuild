---
// Native <details>/<summary> — zero JS, works with scripting fully disabled,
// keyboard-accessible and screen-reader-friendly for free.
interface Props {
  faqs: { question: string; answer: string }[];
  title: string;
}
const { faqs, title } = Astro.props;
---

{faqs.length > 0 && (
  <section class="faq">
    <h2>{title}</h2>
    {faqs.map((faq, index) => (
      <details class="faq-item" name="course-faq" open={index === 0}>
        <summary>{faq.question}</summary>
        <p>{faq.answer}</p>
      </details>
    ))}
  </section>
)}

<style>
  .faq { margin-top: var(--space-6); padding: clamp(1.15rem, 3vw, 2rem); border: 1px solid var(--color-border); border-radius: 1.6rem; background: var(--color-bg-raised); box-shadow: var(--shadow-sm); }
  .faq h2 { margin: 0 0 .5rem; color: var(--color-navy); }
  .faq-item {
    margin-top: .65rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: .95rem;
    background: var(--color-surface-soft);
    transition: border-color var(--motion-fast) var(--ease), background var(--motion-fast) var(--ease);
  }
  .faq-item[open] { border-color: rgb(182 23 51 / .24); background: rgb(182 23 51 / .045); }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-display);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    font-size: var(--fs-lg);
    color: var(--color-crimson-text);
    flex-shrink: 0;
    transition: transform var(--motion-fast) var(--ease);
  }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { margin-top: var(--space-2); color: var(--color-ink-muted); }
</style>
