---
import { useTranslations, localizePath, categoryLabels, type Locale } from '../i18n/ui';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: Locale;
  course: CollectionEntry<'courses'>;
  /** slug without locale prefix, e.g. "kids-general" */
  slug: string;
}

const { locale, course, slug } = Astro.props;
const t = useTranslations(locale);
const { title, summary, category, level, price, currency, durationWeeks, hoursPerMonth, hoursPerLevel } = course.data;
const formattedPrice = price?.toLocaleString('en-US');
---

<style is:global>
  .course-card[data-course] {
    background: linear-gradient(145deg, var(--course-bg-start, var(--course-soft)), var(--course-bg-end, var(--course-soft))) !important;
  }
  .course-card[data-course] .meta {
    border-color: color-mix(in srgb, var(--course-accent) 24%, var(--color-border)) !important;
    background: color-mix(in srgb, var(--course-soft) 76%, var(--color-bg-raised)) !important;
  }
  /* Same palette as the homepage tiles — one course, one color in either view. */
  .course-card[data-course='kids-general'] { --course-accent: #41670e !important; --course-soft: #dff5ae !important; --course-bg-start: #dff5ae; --course-bg-end: #a9d96b; }
  .course-card[data-course='adults-general'] { --course-accent: #29497d !important; --course-soft: #dce8ff !important; --course-bg-start: #dce8ff; --course-bg-end: #abc4f0; }
  .course-card[data-course='business-english'] { --course-accent: #0d623a !important; --course-soft: #cbeed9 !important; --course-bg-start: #cbeed9; --course-bg-end: #84d0a4; }
  .course-card[data-course='university-exam-prep'] { --course-accent: #824500 !important; --course-soft: #ffe0a8 !important; --course-bg-start: #ffe0a8; --course-bg-end: #f4ad54; }
  .course-card[data-course='womens-general-english'] { --course-accent: #8b1647 !important; --course-soft: #f9d1df !important; --course-bg-start: #f9d1df; --course-bg-end: #e889ad; }
  .course-card[data-course='ielts-preparation'] { --course-accent: #8d112b !important; --course-soft: #f8c9d1 !important; --course-bg-start: #f8c9d1; --course-bg-end: #e9798c; }
  .course-card[data-course='step-exam-preparation'] { --course-accent: #3d5d99 !important; --course-soft: #e8eefb !important; }
  :root[data-theme='dark'] .course-card[data-course='step-exam-preparation'] { --course-accent: #b8caef !important; --course-soft: #384967 !important; --course-bg-start: #384967; --course-bg-end: #181d2c; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .course-card[data-course='kids-general'] { --course-accent: #c3ed79 !important; --course-soft: #3d5427 !important; --course-bg-start: #3d5427; --course-bg-end: #17200f; }
    :root:not([data-theme='light']) .course-card[data-course='adults-general'] { --course-accent: #b8caef !important; --course-soft: #384967 !important; --course-bg-start: #384967; --course-bg-end: #181d2c; }
    :root:not([data-theme='light']) .course-card[data-course='business-english'] { --course-accent: #82e4a5 !important; --course-soft: #28583d !important; --course-bg-start: #28583d; --course-bg-end: #102718; }
    :root:not([data-theme='light']) .course-card[data-course='university-exam-prep'] { --course-accent: #ffc879 !important; --course-soft: #573715 !important; --course-bg-start: #573715; --course-bg-end: #25130a; }
    :root:not([data-theme='light']) .course-card[data-course='womens-general-english'] { --course-accent: #ff9fbe !important; --course-soft: #592e46 !important; --course-bg-start: #592e46; --course-bg-end: #29111f; }
    :root:not([data-theme='light']) .course-card[data-course='ielts-preparation'] { --course-accent: #ff9aaa !important; --course-soft: #592633 !important; --course-bg-start: #592633; --course-bg-end: #260e16; }
    :root:not([data-theme='light']) .course-card[data-course='step-exam-preparation'] { --course-accent: #b8caef !important; --course-soft: #384967 !important; --course-bg-start: #384967; --course-bg-end: #181d2c; }
  }
  :root[data-theme='dark'] .course-card[data-course='kids-general'] { --course-accent: #c3ed79 !important; --course-soft: #3d5427 !important; --course-bg-start: #3d5427; --course-bg-end: #17200f; }
  :root[data-theme='dark'] .course-card[data-course='adults-general'] { --course-accent: #b8caef !important; --course-soft: #384967 !important; --course-bg-start: #384967; --course-bg-end: #181d2c; }
  :root[data-theme='dark'] .course-card[data-course='business-english'] { --course-accent: #82e4a5 !important; --course-soft: #28583d !important; --course-bg-start: #28583d; --course-bg-end: #102718; }
  :root[data-theme='dark'] .course-card[data-course='university-exam-prep'] { --course-accent: #ffc879 !important; --course-soft: #573715 !important; --course-bg-start: #573715; --course-bg-end: #25130a; }
  :root[data-theme='dark'] .course-card[data-course='womens-general-english'] { --course-accent: #ff9fbe !important; --course-soft: #592e46 !important; --course-bg-start: #592e46; --course-bg-end: #29111f; }
  :root[data-theme='dark'] .course-card[data-course='ielts-preparation'] { --course-accent: #ff9aaa !important; --course-soft: #592633 !important; --course-bg-start: #592633; --course-bg-end: #260e16; }
</style>

<article class="course-card" data-category={category} data-course={slug}>
  <div class="card-top">
    <span class="category-icon"><Icon name={category} size={20} /></span>
    <span class="badge">{categoryLabels[locale][category]}</span>
    {level && <span class="badge badge-level numeric">{level}</span>}
  </div>
  <h2><a href={localizePath(locale, `/courses/${slug}`)}>{title}</a></h2>
  <p>{summary}</p>
  <div class="meta" aria-label={locale === 'ar' ? 'تفاصيل الدورة' : 'Course details'}>
    <div class="price-row">
      <span class="fact-label"><i><Icon name="tag" size={15} /></i>{t('courses.price')}</span>
      {price !== undefined ? (
        <strong class="price numeric">{formattedPrice}<small>{currency}</small></strong>
      ) : (
        <strong class="contact-price">{t('courses.contactDetails')}</strong>
      )}
    </div>
    {/* Price already covers the "no data yet" case with its own contact
        message above — showing two more placeholder-dash boxes here on
        top of that would be redundant and (with the schedule-item's fixed
        min-height) clip the "Varies" label rather than help the visitor. */}
    {price !== undefined && (durationWeeks !== undefined || hoursPerMonth || hoursPerLevel) && (
    <div class="schedule-grid">
      {durationWeeks !== undefined ? (
      <div class="schedule-item weeks-fact">
        <span class="fact-label"><i><Icon name="calendar" size={14} /></i>{t('courses.weeksPerLevel')}</span>
        <strong class="metric-shape numeric">{durationWeeks}</strong>
      </div>
      ) : (
      <div class="schedule-item weeks-fact is-variable">
        <span class="fact-label"><i><Icon name="calendar" size={14} /></i>{t('courses.weeksPerLevel')}</span>
        <p>{t('courses.varies')}</p>
      </div>
      )}
      {hoursPerLevel ? (
      <div class="schedule-item hours-fact">
        <span class="fact-label"><i><Icon name="clock" size={14} /></i>{t('courseDetail.levelHours')}</span>
        <strong class="metric-shape numeric">{hoursPerLevel}</strong>
      </div>
      ) : hoursPerMonth ? (
      <div class="schedule-item hours-fact">
        <span class="fact-label"><i><Icon name="clock" size={14} /></i>{t('courses.monthlyHours')}</span>
        <strong class="metric-shape numeric">{hoursPerMonth}</strong>
      </div>
      ) : (
      <div class="schedule-item hours-fact is-variable">
        <span class="fact-label"><i><Icon name="clock" size={14} /></i>{t('courses.monthlyHours')}</span>
        <p>{t('courses.varies')}</p>
      </div>
      )}
    </div>
    )}
  </div>
  <a href={localizePath(locale, `/courses/${slug}`)} class="btn btn-outline">{t('courses.viewCourse')}</a>
</article>

<style>
  .course-card {
    --course-accent: var(--color-primary-text);
    --course-soft: var(--color-blue-soft);
    min-height: 22rem;
    border: 1px solid color-mix(in srgb, var(--course-accent) 18%, var(--color-border));
    border-radius: 1.4rem;
    padding: 1.6rem;
    background: linear-gradient(145deg, var(--color-bg-raised) 54%, var(--course-soft));
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
    transition: transform var(--motion-fast) var(--ease), box-shadow var(--motion-fast) var(--ease);
  }
  .course-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }
  .card-top { display: flex; align-items: center; gap: var(--space-2); }
  .category-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: .75rem;
    background: var(--course-soft);
    color: var(--course-accent);
  }
  .badge {
    font-size: var(--fs-sm);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border);
    color: #5a5d63; /* darker than --color-ink-muted to meet 4.5:1 contrast on --color-surface-soft */
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .badge { color: var(--color-ink-muted); }
  }
  :root[data-theme="dark"] .badge { color: var(--color-ink-muted); }
  .badge-level { color: var(--course-accent); border-color: color-mix(in srgb, var(--course-accent) 32%, var(--color-border)); background: var(--course-soft); }
  h2 { margin: 0; font-size: clamp(1.25rem, 2vw, 1.45rem); line-height: 1.3; }
  h2 a { color: var(--color-navy); }
  h2 a:hover { color: var(--course-accent); text-decoration: none; }
  .course-card[data-course='kids-general'] { --course-accent: #568019; --course-soft: #eef8d8; }
  .course-card[data-course='adults-general'] { --course-accent: #3d5d99; --course-soft: #e8eefb; }
  .course-card[data-course='business-english'] { --course-accent: #187247; --course-soft: #e1f5e9; }
  .course-card[data-course='university-exam-prep'] { --course-accent: #9a5708; --course-soft: #fff0d7; }
  .course-card[data-course='womens-general-english'] { --course-accent: #a52b59; --course-soft: #fde7ef; }
  .course-card[data-course='ielts-preparation'] { --course-accent: #a71938; --course-soft: #fbe5e8; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .course-card[data-course='kids-general'] { --course-accent: #c3ed79; --course-soft: #29351e; }
    :root:not([data-theme="light"]) .course-card[data-course='adults-general'] { --course-accent: #b8caef; --course-soft: #292d38; }
    :root:not([data-theme="light"]) .course-card[data-course='business-english'] { --course-accent: #82e4a5; --course-soft: #20362a; }
    :root:not([data-theme="light"]) .course-card[data-course='university-exam-prep'] { --course-accent: #ffc879; --course-soft: #3a2a1b; }
    :root:not([data-theme="light"]) .course-card[data-course='womens-general-english'] { --course-accent: #ff9fbe; --course-soft: #3b2430; }
    :root:not([data-theme="light"]) .course-card[data-course='ielts-preparation'] { --course-accent: #ff9aaa; --course-soft: #3a2026; }
  }
  :root[data-theme="dark"] .course-card[data-course='kids-general'] { --course-accent: #c3ed79; --course-soft: #29351e; }
  :root[data-theme="dark"] .course-card[data-course='adults-general'] { --course-accent: #b8caef; --course-soft: #292d38; }
  :root[data-theme="dark"] .course-card[data-course='business-english'] { --course-accent: #82e4a5; --course-soft: #20362a; }
  :root[data-theme="dark"] .course-card[data-course='university-exam-prep'] { --course-accent: #ffc879; --course-soft: #3a2a1b; }
  :root[data-theme="dark"] .course-card[data-course='womens-general-english'] { --course-accent: #ff9fbe; --course-soft: #3b2430; }
  :root[data-theme="dark"] .course-card[data-course='ielts-preparation'] { --course-accent: #ff9aaa; --course-soft: #3a2026; }
  .course-card > p { color: var(--color-ink-muted); font-size: .95rem; line-height: 1.7; }
  .meta { display: grid; gap: .75rem; margin-top: auto; padding: .9rem; border: 1px solid color-mix(in srgb, var(--course-accent) 15%, var(--color-border)); border-radius: 1rem; background: linear-gradient(145deg, color-mix(in srgb, var(--color-bg-raised) 94%, var(--course-soft)), var(--course-soft)); }
  .price-row { position: relative; display: flex; min-height: 3.6rem; align-items: center; justify-content: space-between; gap: .75rem; padding-bottom: .7rem; border-bottom: 1px solid var(--color-border); }
  .fact-label { display: inline-flex; min-width: 0; align-items: center; gap: .38rem; color: var(--color-ink-muted); font-size: .64rem; font-weight: 750; text-transform: uppercase; letter-spacing: .04em; }
  :global(:lang(ar)) .fact-label { letter-spacing: 0; }
  .fact-label i { display: grid; width: 1.65rem; height: 1.65rem; flex: 0 0 auto; place-items: center; border-radius: .55rem; color: var(--fact-color, var(--color-primary)); background: var(--fact-soft, var(--color-blue-soft)); font-style: normal; }
  .price-row .fact-label i { color: #fff; background: var(--color-primary); box-shadow: 0 6px 15px rgb(182 23 51 / .2); }
  .price { position: relative; display: inline-flex; align-items: baseline; gap: .3rem; padding: .58rem .7rem .52rem; border: 1px solid rgb(182 23 51 / .18); border-radius: .85rem .85rem .85rem .3rem; color: #fff; background: linear-gradient(135deg, var(--color-primary), #d95f35); box-shadow: 0 9px 22px rgb(182 23 51 / .2); font-size: clamp(1.45rem, 2.5vw, 1.9rem); font-weight: 850; line-height: 1; letter-spacing: -.04em; }
  :global(:dir(rtl)) .price { border-radius: .85rem .85rem .3rem .85rem; }
  .price small { color: rgb(255 255 255 / .82); font-size: .6rem; font-weight: 800; letter-spacing: 0; }
  .contact-price { max-width: 13rem; color: var(--color-primary-text); font-size: .68rem; line-height: 1.35; text-align: end; }
  .schedule-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; }
  .schedule-item { --fact-color: var(--color-primary); --fact-text: var(--color-primary-text); --fact-soft: var(--color-blue-soft); position: relative; display: grid; min-width: 0; min-height: 6rem; align-content: space-between; padding: .62rem; overflow: hidden; border: 1px solid rgb(182 23 51 / .1); border-radius: .85rem; background: var(--color-bg-raised); }
  .schedule-item::after { content: ''; position: absolute; width: 3.5rem; height: 3.5rem; inset-inline-end: -2rem; bottom: -2rem; border-radius: 50%; background: var(--fact-soft); opacity: .9; }
  .hours-fact { --fact-color: var(--color-amber-text); --fact-text: var(--color-amber-text); --fact-soft: var(--color-yellow-soft); border-color: rgb(155 93 13 / .14); }
  .metric-shape { position: relative; z-index: 1; display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border: 1px solid color-mix(in srgb, var(--fact-text) 18%, transparent); border-radius: .85rem .85rem .85rem .28rem; color: var(--fact-text); background: var(--fact-soft); box-shadow: 0 7px 16px rgb(49 43 40 / .08); font-size: 1.35rem; font-weight: 850; line-height: 1; transform: rotate(-2deg); }
  :global(:dir(rtl)) .metric-shape { border-radius: .85rem .85rem .28rem .85rem; transform: rotate(2deg); }
  .schedule-item.is-variable { justify-items: start; align-content: start; gap: .4rem; }
  .schedule-item.is-variable p { position: relative; z-index: 1; margin: 0; color: var(--color-ink-muted); font-size: .72rem; font-weight: 650; line-height: 1.35; }
</style>
