---
import { useTranslations, localizePath, categoryLabels, type Locale } from '../i18n/ui';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: Locale;
  course: CollectionEntry<'courses'>;
  /** slug without locale prefix, e.g. "kids-general" */
  slug: string;
}

const { locale, course, slug } = Astro.props;
const t = useTranslations(locale);
const { title, summary, category, level, price, currency, durationWeeks, hoursPerWeek } = course.data;
---

<article class="course-card" data-category={category}>
  <div class="card-top">
    <span class="category-icon"><Icon name={category} size={20} /></span>
    <span class="badge">{categoryLabels[locale][category]}</span>
    <span class="badge badge-level numeric">{level}</span>
  </div>
  <h2><a href={localizePath(locale, `/courses/${slug}`)}>{title}</a></h2>
  <p>{summary}</p>
  <div class="meta">
    <p class="numeric price">{price} {currency}</p>
    <p class="numeric duration">
      {durationWeeks} {t('courses.weeks')} · {hoursPerWeek} {t('courses.hoursPerWeek')}
    </p>
  </div>
  <a href={localizePath(locale, `/courses/${slug}`)} class="btn btn-outline">{t('courses.viewCourse')}</a>
</article>

<style>
  .course-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    background: var(--color-bg-raised);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .card-top { display: flex; align-items: center; gap: var(--space-2); }
  .category-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-crimson-text);
  }
  .badge {
    font-size: var(--fs-sm);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-ink-muted);
  }
  .badge-level { color: var(--color-crimson-text); border-color: var(--color-crimson-text); }
  h2 { margin: 0; font-size: var(--fs-lg); }
  h2 a { color: var(--color-ink); }
  h2 a:hover { color: var(--color-crimson-text); text-decoration: none; }
  .meta p { margin: 0; }
  .price { font-size: var(--fs-lg); font-weight: 700; color: var(--color-crimson-text); }
  .duration { color: var(--color-ink-muted); font-size: var(--fs-sm); }
</style>
