---
import type { CollectionEntry } from 'astro:content';
import { localizePath, type Locale } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  posts: CollectionEntry<'blog'>[];
}

const { locale, posts } = Astro.props;
const isArabic = locale === 'ar';
const [featured, ...remaining] = posts;
const copy = isArabic ? {
  latest: 'أحدث قصة',
  insight: 'رؤى تعليمية',
  read: 'اقرأ المقال',
  more: 'المزيد من الأخبار والرؤى',
  empty: 'ستُنشر أخبار ومقالات جديدة قريبًا.',
} : {
  latest: 'Latest story',
  insight: 'Learning insight',
  read: 'Read article',
  more: 'More news & insights',
  empty: 'New stories and updates will appear here soon.',
};

const formatDate = (date: Date) => date.toLocaleDateString(isArabic ? 'ar-SA' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const postHref = (post: CollectionEntry<'blog'>) => localizePath(locale, `/blog/${post.id.replace(`${locale}/`, '')}`);
---

<section class="news-section">
  <div class="container">
    {featured ? (
      <a class="featured-story" href={postHref(featured)}>
        <div class="featured-copy">
          <div class="story-meta">
            <span class="story-label"><i></i>{copy.latest}</span>
            <time class:list={[{ numeric: !isArabic }]} datetime={featured.data.publishDate.toISOString()}>{formatDate(featured.data.publishDate)}</time>
          </div>
          <span class="story-category">{copy.insight}</span>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.summary}</p>
          <span class="read-link">{copy.read}<b aria-hidden="true">↗</b></span>
        </div>
        <div class="featured-visual" aria-hidden="true">
          <span class="visual-orbit orbit-one"></span>
          <span class="visual-orbit orbit-two"></span>
          <span class="visual-glyph">{isArabic ? 'أب' : 'Aa'}</span>
          <span class="visual-card visual-card-top"><Icon name="chat" size={20} />{isArabic ? 'تعلّم' : 'Learn'}</span>
          <span class="visual-card visual-card-bottom"><Icon name="pathway" size={20} />{isArabic ? 'تقدّم' : 'Grow'}</span>
          <span class="visual-number numeric">01</span>
        </div>
      </a>
    ) : <p class="empty-state">{copy.empty}</p>}

    {remaining.length > 0 && (
      <div class="more-stories">
        <div class="stories-heading">
          <h2>{copy.more}</h2>
          <span class="numeric">{String(remaining.length).padStart(2, '0')}</span>
        </div>
        <div class="story-grid">
          {remaining.map((post, index) => (
            <article class="story-card">
              <div class="card-meta"><span class="numeric">{String(index + 2).padStart(2, '0')}</span><time class:list={[{ numeric: !isArabic }]} datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time></div>
              <h3><a href={postHref(post)}>{post.data.title}</a></h3>
              <p>{post.data.summary}</p>
              <a class="card-link" href={postHref(post)} aria-label={`${copy.read}: ${post.data.title}`}><Icon name="arrow-up" size={18} /></a>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .news-section { padding-block: clamp(4rem, 8vw, 7rem); background: linear-gradient(180deg, #fff 0%, var(--color-surface-soft) 100%); }
  .featured-story { position: relative; display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(20rem, .88fr); min-height: 29rem; overflow: hidden; border-radius: 2rem; color: #fff; background: var(--color-navy); box-shadow: 0 35px 80px rgb(25 39 69 / .24); transition: transform var(--motion-base) var(--ease), box-shadow var(--motion-base) var(--ease); }
  .featured-story:hover { color: #fff; text-decoration: none; transform: translateY(-7px); box-shadow: 0 45px 95px rgb(25 39 69 / .3); }
  .featured-copy { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 5vw, 4.5rem); }
  .story-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.75rem; }
  .story-meta time { display: inline-flex; align-items: center; min-height: 2rem; padding: .42rem .68rem; border: 1px solid #50535f; border-radius: .7rem; color: #fff; background: rgb(255 255 255 / .08); font-size: .76rem; font-weight: 750; box-shadow: inset 0 1px 0 rgb(255 255 255 / .08); }
  .story-label { display: inline-flex; align-items: center; gap: .5rem; color: #f7b75f; font-size: .76rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  :global(:lang(ar)) .story-label { letter-spacing: 0; }
  .story-label i { width: .5rem; height: .5rem; border-radius: 50%; background: var(--color-coral); box-shadow: 0 0 0 5px rgb(242 148 32 / .14); }
  .story-category { align-self: flex-start; margin-bottom: 1rem; padding: .38rem .65rem; border: 1px solid #4d5060; border-radius: 999px; color: #d7d9df; background: rgb(255 255 255 / .05); font-size: .68rem; font-weight: 750; }
  .featured-story h2 { max-width: 18ch; margin-bottom: 1rem; color: #fff; font-size: clamp(1.9rem, 3.2vw, 3.35rem); line-height: 1.08; letter-spacing: -.045em; }
  :global(:lang(ar)) .featured-story h2 { max-width: 17ch; line-height: 1.3; letter-spacing: -.025em; }
  .featured-story p { max-width: 52ch; margin: 0; color: #c8c9ce; font-size: 1rem; line-height: 1.75; }
  .read-link { display: inline-flex; align-items: center; gap: .7rem; margin-top: 2rem; font-size: .82rem; font-weight: 850; }
  .read-link b { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border-radius: 50%; color: var(--color-navy); background: #fff; transition: transform var(--motion-fast) var(--ease); }
  .featured-story:hover .read-link b { transform: translate(3px, -3px); }
  :global(:dir(rtl)) .read-link b { transform: scaleX(-1); }
  :global(:dir(rtl)) .featured-story:hover .read-link b { transform: translate(-3px, -3px) scaleX(-1); }
  .featured-visual { position: relative; min-height: 24rem; overflow: hidden; background: linear-gradient(145deg, var(--color-primary), #d66f1f); }
  .featured-visual::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / .2) 1px, transparent 0); background-size: 22px 22px; mask-image: linear-gradient(to bottom, black, transparent); }
  .visual-glyph { position: absolute; inset: 50% auto auto 50%; color: rgb(255 255 255 / .94); font-family: var(--font-display); font-size: clamp(7rem, 14vw, 12rem); font-weight: 850; letter-spacing: -.12em; text-shadow: 0 18px 45px rgb(76 13 28 / .25); transform: translate(-52%, -54%) rotate(-7deg); }
  :global(:lang(ar)) .visual-glyph { letter-spacing: -.06em; transform: translate(-50%, -52%) rotate(5deg); }
  .visual-orbit { position: absolute; inset: 50% auto auto 50%; border: 1px solid rgb(255 255 255 / .3); border-radius: 50%; transform: translate(-50%, -50%); }
  .orbit-one { width: 18rem; height: 18rem; }
  .orbit-two { width: 25rem; height: 25rem; border-style: dashed; opacity: .55; }
  .visual-card { position: absolute; display: flex; align-items: center; gap: .5rem; padding: .65rem .8rem; border: 1px solid rgb(255 255 255 / .55); border-radius: .9rem; color: var(--color-navy); background: rgb(255 255 255 / .9); box-shadow: 0 15px 35px rgb(88 18 34 / .2); font-size: .72rem; font-weight: 850; backdrop-filter: blur(10px); }
  .visual-card-top { inset-inline-start: 8%; top: 16%; transform: rotate(-5deg); }
  .visual-card-bottom { inset-inline-end: 8%; bottom: 15%; transform: rotate(5deg); }
  .visual-number { position: absolute; display: grid; width: 3.35rem; height: 3.35rem; place-items: center; inset-inline-end: 1.5rem; top: 1.5rem; border: 1px solid rgb(255 255 255 / .72); border-radius: 1rem 1rem 1rem .32rem; color: var(--color-primary); background: #fff; box-shadow: 0 15px 32px rgb(88 18 34 / .24); font-size: 1rem; font-weight: 900; letter-spacing: .02em; transform: rotate(3deg); }
  :global(:dir(rtl)) .visual-number { border-radius: 1rem 1rem .32rem 1rem; transform: rotate(-3deg); }
  .featured-story:hover .visual-glyph { animation: glyph-lift .8s var(--ease) both; }
  .more-stories { margin-top: clamp(4rem, 8vw, 7rem); }
  .stories-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .stories-heading h2 { margin: 0; color: var(--color-navy); font-size: clamp(2rem, 4vw, 3.5rem); }
  .stories-heading > span { display: grid; width: 2.7rem; height: 2.7rem; place-items: center; border-radius: .85rem; color: #fff; background: var(--color-primary); font-size: .78rem; font-weight: 850; }
  .story-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .story-card { position: relative; display: flex; min-height: 20rem; flex-direction: column; padding: 1.4rem; border: 1px solid var(--color-border); border-radius: 1.4rem; background: #fff; box-shadow: var(--shadow-sm); transition: transform var(--motion-base) var(--ease), box-shadow var(--motion-base) var(--ease); }
  .story-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
  .card-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--color-ink-muted); font-size: .7rem; }
  .card-meta > span { display: grid; width: 2.65rem; height: 2.65rem; flex: 0 0 auto; place-items: center; border-radius: .82rem .82rem .82rem .25rem; color: #fff; background: linear-gradient(135deg, var(--color-primary), #d95f35); box-shadow: 0 9px 20px rgb(182 23 51 / .2); font-size: .78rem; font-weight: 900; }
  :global(:dir(rtl)) .card-meta > span { border-radius: .82rem .82rem .25rem .82rem; }
  .card-meta time { padding: .38rem .55rem; border: 1px solid var(--color-border); border-radius: .6rem; color: var(--color-navy); background: var(--color-surface-soft); font-size: .7rem; font-weight: 750; }
  .story-card h3 { margin: 3rem 0 .7rem; color: var(--color-navy); font-size: 1.3rem; }
  .story-card h3 a { color: inherit; }
  .story-card p { margin: 0; color: var(--color-ink-muted); font-size: .88rem; line-height: 1.7; }
  .card-link { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; margin-top: auto; align-self: flex-end; border-radius: 50%; color: #fff; background: var(--color-primary); }
  .empty-state { padding: 3rem; border: 1px dashed var(--color-border-strong); border-radius: 1.5rem; text-align: center; }
  @keyframes glyph-lift { 50% { transform: translate(-52%, -58%) rotate(-3deg) scale(1.04); } }
  @media (max-width: 850px) {
    .featured-story { grid-template-columns: 1fr; }
    .featured-visual { min-height: 22rem; }
    .story-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .featured-story { min-height: 0; border-radius: 1.5rem; }
    .featured-copy { padding: 1.5rem; }
    .featured-story h2 { font-size: clamp(1.8rem, 8vw, 2.5rem); }
    .featured-visual { min-height: 18rem; }
    .story-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .featured-story:hover .visual-glyph { animation: none; } }
</style>
