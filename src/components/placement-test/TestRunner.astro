---
import type { useTranslations } from '../../i18n/ui';

export interface Props {
  t: ReturnType<typeof useTranslations>;
}
const { t } = Astro.props;
---

<section
  id="placement-test-runner"
  class="card"
  hidden
  data-question-label={t('placementTest.questionOf')}
  data-answer-error={t('placementTest.answerError')}
  data-answer-submit={t('placementTest.answerSubmit')}
  data-answer-placeholder={t('placementTest.answerPlaceholder')}
  data-reading-passage={t('placementTest.readingPassage')}
  data-correct={t('placementTest.correct')}
  data-incorrect={t('placementTest.incorrect')}
  data-skip={t('placementTest.skip')}
  data-true={t('placementTest.true')}
  data-false={t('placementTest.false')}
>
  <header class="runner-heading">
    <div>
      <p class="runner-eyebrow">{t('placementTest.stageQuestions')}</p>
      <h2>{t('placementTest.runnerHeading')}</h2>
      <p class="runner-intro">{t('placementTest.runnerIntro')}</p>
    </div>
    <span id="pt-progress-percent" class="pt-progress-percent numeric">0%</span>
  </header>
  <p id="pt-progress" class="pt-progress"></p>
  <div id="pt-progress-track" class="pt-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div id="pt-progress-fill" class="pt-progress-fill"></div>
  </div>
  <details id="pt-passage" class="pt-passage" hidden>
    <summary id="pt-passage-title" class="pt-passage-title"></summary>
    <p id="pt-passage-body" class="pt-passage-body"></p>
  </details>
  <div id="pt-image-stage" class="pt-image-stage" hidden>
    <span class="pt-image-spark pt-image-spark-one" aria-hidden="true">★</span>
    <span class="pt-image-spark pt-image-spark-two" aria-hidden="true">●</span>
    <img id="pt-image" class="pt-image" alt="" />
  </div>
  <div id="pt-counting-strip" class="pt-counting-strip" aria-label="Count in order from 1 to 7" hidden>
    <button type="button">1</button><button type="button">2</button><button type="button">3</button><button type="button">4</button><button type="button">5</button><button type="button">6</button><button type="button">7</button>
  </div>
  <div id="pt-picture-word-bank" class="pt-picture-word-bank" aria-label="Choose from these words" hidden>
    <button type="button">Book</button><button type="button">Pen</button><button type="button">Car</button><button type="button">Tree</button><button type="button">Apple</button>
  </div>
  <div id="pt-room-word-bank" class="pt-picture-word-bank" aria-label="Choose from these room words" hidden>
    <button type="button">Sofa</button><button type="button">Curtain</button><button type="button">Picture</button><button type="button">TV</button><button type="button">Lamps</button>
  </div>
  <div id="pt-action-word-bank" class="pt-picture-word-bank" aria-label="Choose from these action words" hidden>
    <button type="button">Climbing</button><button type="button">Flying</button><button type="button">Playing</button><button type="button">Riding</button><button type="button">Throwing</button>
  </div>
  <p id="pt-prompt" class="pt-prompt"></p>
  <div id="pt-options" class="pt-options"></div>
  <button type="button" id="pt-skip" class="pt-skip-btn"></button>
  <p id="pt-feedback" class="pt-feedback" role="status" aria-live="polite" hidden></p>
  <p id="pt-error" class="pt-error" role="alert" hidden></p>
</section>

<script>
  import { startSession, submitAnswer } from '../../lib/placementApi';
  import type { QuestionPayload } from '../../lib/placementApi';

  const runner = document.getElementById('placement-test-runner') as HTMLElement;
  const progressEl = document.getElementById('pt-progress') as HTMLElement;
  const progressTrackEl = document.getElementById('pt-progress-track') as HTMLElement;
  const progressFillEl = document.getElementById('pt-progress-fill') as HTMLElement;
  const progressPercentEl = document.getElementById('pt-progress-percent') as HTMLElement;
  const passageEl = document.getElementById('pt-passage') as HTMLDetailsElement;
  const passageTitleEl = document.getElementById('pt-passage-title') as HTMLElement;
  const passageBodyEl = document.getElementById('pt-passage-body') as HTMLElement;
  const imageStageEl = document.getElementById('pt-image-stage') as HTMLElement;
  const imageEl = document.getElementById('pt-image') as HTMLImageElement;
  const countingStripEl = document.getElementById('pt-counting-strip') as HTMLElement;
  const pictureWordBankEl = document.getElementById('pt-picture-word-bank') as HTMLElement;
  const roomWordBankEl = document.getElementById('pt-room-word-bank') as HTMLElement;
  const actionWordBankEl = document.getElementById('pt-action-word-bank') as HTMLElement;
  const promptEl = document.getElementById('pt-prompt') as HTMLElement;
  const optionsEl = document.getElementById('pt-options') as HTMLElement;
  const feedbackEl = document.getElementById('pt-feedback') as HTMLElement;
  const errorEl = document.getElementById('pt-error') as HTMLElement;
  const skipBtn = document.getElementById('pt-skip') as HTMLButtonElement;
  const questionLabel = runner.dataset.questionLabel ?? '';
  const answerErrorText = runner.dataset.answerError ?? '';
  const answerSubmitText = runner.dataset.answerSubmit ?? 'Submit';
  const answerPlaceholderText = runner.dataset.answerPlaceholder ?? 'Type your answer here';
  const readingPassageLabel = runner.dataset.readingPassage ?? 'Reading passage';
  const correctText = runner.dataset.correct ?? 'Correct!';
  const incorrectText = runner.dataset.incorrect ?? 'Incorrect';
  skipBtn.textContent = runner.dataset.skip ?? "I don't understand — skip";
  const trueText = runner.dataset.true ?? 'True';
  const falseText = runner.dataset.false ?? 'False';
  // How long the correct/incorrect feedback stays on screen before the next
  // question loads -- long enough to register, short enough not to feel like
  // a stall between questions.
  const FEEDBACK_DELAY_MS = 1100;
  let sessionId = '';
  let lastPassageId = '';

  function setProgress(questionNumber: number, total: number) {
    progressEl.textContent = total > 0 ? `${questionLabel} ${questionNumber} / ${total}` : `${questionLabel} ${questionNumber}`;
    const pct = total > 0 ? Math.min(100, Math.round((questionNumber / total) * 100)) : 0;
    progressFillEl.style.width = `${pct}%`;
    progressPercentEl.textContent = `${pct}%`;
    progressTrackEl.setAttribute('aria-valuenow', String(pct));
  }

  function showFeedback(correct: boolean | undefined, selectedEl: HTMLElement | null) {
    if (correct === undefined) {
      feedbackEl.hidden = true;
      return;
    }
    feedbackEl.hidden = false;
    feedbackEl.textContent = correct ? correctText : incorrectText;
    feedbackEl.className = `pt-feedback ${correct ? 'pt-feedback-correct' : 'pt-feedback-incorrect'}`;
    selectedEl?.classList.add(correct ? 'pt-selected-correct' : 'pt-selected-incorrect');
  }

  async function handleSubmit(
    step: QuestionPayload,
    answer: { selectedIndex: number } | { answerText: string } | { skip: true },
    disabledEls: Array<HTMLButtonElement | HTMLInputElement>,
    selectedEl: HTMLElement | null
  ) {
    disabledEls.forEach((el) => (el.disabled = true));
    skipBtn.disabled = true;
    errorEl.hidden = true;
    try {
      const next = await submitAnswer(sessionId, step.questionId, answer);
      showFeedback(next.correct, selectedEl);
      window.setTimeout(
        () => {
          if (next.done) {
            progressFillEl.style.width = '100%';
            document.dispatchEvent(new CustomEvent('placement:done', { detail: { level: next.level, levelName: next.levelName, yle: next.yle, sessionId } }));
            runner.hidden = true;
          } else {
            renderQuestion(next);
          }
        },
        next.correct === undefined ? 0 : FEEDBACK_DELAY_MS
      );
    } catch {
      // Network/API failure mid-test: re-enable the inputs and show an inline error
      // instead of leaving a frozen, unresponsive question card.
      errorEl.textContent = answerErrorText;
      errorEl.hidden = false;
      disabledEls.forEach((el) => (el.disabled = false));
      skipBtn.disabled = false;
    }
  }

  function renderQuestion(step: QuestionPayload) {
    setProgress(step.questionNumber, step.total);
    feedbackEl.hidden = true;
    skipBtn.disabled = false;
    // Re-bound each render (rather than once) so the closure always skips
    // *this* question's id and disables *this* question's currently-rendered
    // inputs, whatever type they are.
    skipBtn.onclick = () => {
      const inputEls = Array.from(
        runner.querySelectorAll('#pt-options button, #pt-options input, #pt-picture-word-bank:not([hidden]) button, #pt-room-word-bank:not([hidden]) button, #pt-action-word-bank:not([hidden]) button, #pt-counting-strip:not([hidden]) button')
      ) as Array<HTMLButtonElement | HTMLInputElement>;
      handleSubmit(step, { skip: true }, inputEls, null);
    };

    if (step.passage) {
      passageEl.hidden = false;
      passageTitleEl.textContent = `${readingPassageLabel}: ${step.passage.title}`;
      passageBodyEl.textContent = step.passage.body;
      // Auto-expand only the first question of a new passage; once the student has
      // opened or closed it, later questions sharing that same passage leave the
      // <details> state alone instead of forcing it back open every render.
      if (step.passage.id !== lastPassageId) {
        passageEl.open = true;
        lastPassageId = step.passage.id;
      }
    } else {
      passageEl.hidden = true;
      lastPassageId = '';
    }

    if (step.imageUrl) {
      imageEl.src = step.imageUrl;
      imageStageEl.hidden = false;
    } else {
      imageStageEl.hidden = true;
      imageEl.removeAttribute('src');
    }
    const countingPrefix = /^Count in order:\s*1,\s*2,\s*3,\s*4,\s*5,\s*6,\s*7\.\s*/i;
    const isCountingQuestion = countingPrefix.test(step.prompt);
    const isPictureMatch = /^Match the picture to the word:/i.test(step.prompt);
    const isRoomPicture = /\/(sofa|curtain|picture|tv|lamps)\.svg$/i.test(step.imageUrl ?? '');
    const actionWordPrefix = /^Word bank:\s*climbing,\s*flying,\s*playing,\s*riding,\s*throwing\.\s*/i;
    const isActionWordQuestion = actionWordPrefix.test(step.prompt);
    const letterMatch = step.prompt.match(/^Write the (capital|small) letter for "([A-Za-z])"\.$/i);
    countingStripEl.hidden = !isCountingQuestion;
    pictureWordBankEl.hidden = !isPictureMatch;
    roomWordBankEl.hidden = !isRoomPicture;
    actionWordBankEl.hidden = !isActionWordQuestion;
    imageStageEl.classList.toggle('is-match-picture', isPictureMatch || isRoomPicture);
    promptEl.textContent = isCountingQuestion
      ? step.prompt.replace(countingPrefix, '')
      : isPictureMatch
        ? 'Which word matches this picture?'
        : letterMatch
          ? `Choose the ${letterMatch[1].toLowerCase()} letter for “${letterMatch[2]}”.`
        : isActionWordQuestion
          ? step.prompt.replace(actionWordPrefix, '')
        : step.prompt;
    optionsEl.innerHTML = '';
    errorEl.hidden = true;

    if (isPictureMatch) {
      const wordButtons = Array.from(pictureWordBankEl.querySelectorAll('button')) as HTMLButtonElement[];
      wordButtons.forEach((button) => {
        button.disabled = false;
        button.classList.remove('pt-selected-correct', 'pt-selected-incorrect');
        button.onclick = () => handleSubmit(step, { answerText: button.textContent ?? '' }, wordButtons, button);
      });
      return;
    }

    if (isRoomPicture) {
      const roomButtons = Array.from(roomWordBankEl.querySelectorAll('button')) as HTMLButtonElement[];
      roomButtons.forEach((button) => {
        button.disabled = false;
        button.classList.remove('pt-selected-correct', 'pt-selected-incorrect');
        button.onclick = () => handleSubmit(step, { answerText: button.textContent ?? '' }, roomButtons, button);
      });
      return;
    }

    if (isActionWordQuestion) {
      const actionButtons = Array.from(actionWordBankEl.querySelectorAll('button')) as HTMLButtonElement[];
      actionButtons.forEach((button) => {
        button.disabled = false;
        button.classList.remove('pt-selected-correct', 'pt-selected-incorrect');
        button.onclick = () => handleSubmit(step, { answerText: button.textContent ?? '' }, actionButtons, button);
      });
      return;
    }

    if (isCountingQuestion) {
      const numberButtons = Array.from(countingStripEl.querySelectorAll('button')) as HTMLButtonElement[];
      numberButtons.forEach((button) => {
        button.disabled = false;
        button.classList.remove('pt-selected-correct', 'pt-selected-incorrect');
        button.onclick = () => handleSubmit(step, { answerText: button.textContent ?? '' }, numberButtons, button);
      });
      return;
    }

    if (letterMatch) {
      const sourceLetter = letterMatch[2];
      const choices = [sourceLetter.toUpperCase(), sourceLetter.toLowerCase()];
      const letterOptions = document.createElement('div');
      letterOptions.className = 'pt-letter-options';
      const buttons = choices.map((choice) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'pt-letter-choice';
        button.textContent = choice;
        letterOptions.appendChild(button);
        return button;
      });
      buttons.forEach((button) => {
        button.onclick = () => handleSubmit(step, { answerText: button.textContent ?? '' }, buttons, button);
      });
      optionsEl.appendChild(letterOptions);
      return;
    }

    if (step.type === 'text') {
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'pt-text-input';
      input.placeholder = answerPlaceholderText;
      input.setAttribute('aria-label', answerPlaceholderText);
      input.autocomplete = 'off';
      input.autocapitalize = 'off';
      input.spellcheck = false;
      const submitBtn = document.createElement('button');
      submitBtn.type = 'button';
      submitBtn.className = 'pt-text-submit';
      const submitLabel = document.createElement('span');
      submitLabel.textContent = answerSubmitText;
      const submitIcon = document.createElement('span');
      submitIcon.className = 'pt-text-submit-icon';
      submitIcon.setAttribute('aria-hidden', 'true');
      submitIcon.textContent = '↗';
      submitBtn.appendChild(submitLabel);
      submitBtn.appendChild(submitIcon);
      submitBtn.addEventListener('click', () => {
        if (!input.value.trim()) return;
        handleSubmit(step, { answerText: input.value }, [input, submitBtn], input);
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') submitBtn.click();
      });
      const textAnswer = document.createElement('div');
      textAnswer.className = 'pt-text-answer';
      textAnswer.appendChild(input);
      textAnswer.appendChild(submitBtn);
      optionsEl.appendChild(textAnswer);
      input.focus();
      return;
    }

    const options = step.options ?? [];
    // True/false reading-comprehension items are still plain 2-option mcq rows
    // in the DB (grading is identical to any other mcq), but they read better
    // as a distinct True/False choice than as a vertical 4-option-style list.
    const isTrueFalse = options.length === 2 && options[0] === 'True' && options[1] === 'False';

    if (isTrueFalse) {
      optionsEl.classList.add('pt-options-tf');
      const trueBtn = makeTrueFalseButton('true', 0, step);
      const falseBtn = makeTrueFalseButton('false', 1, step);
      optionsEl.appendChild(trueBtn);
      optionsEl.appendChild(falseBtn);
      return;
    }
    optionsEl.classList.remove('pt-options-tf');

    options.forEach((opt: string, idx: number) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pt-option-btn';
      const key = document.createElement('span');
      key.className = 'pt-option-key';
      key.setAttribute('aria-hidden', 'true');
      key.textContent = String(idx + 1).padStart(2, '0');
      const label = document.createElement('span');
      label.className = 'pt-option-label';
      label.textContent = opt;
      btn.appendChild(key);
      btn.appendChild(label);
      btn.addEventListener('click', () => {
        const buttons = Array.from(optionsEl.querySelectorAll('button')) as HTMLButtonElement[];
        handleSubmit(step, { selectedIndex: idx }, buttons, btn);
      });
      optionsEl.appendChild(btn);
    });
  }

  function makeTrueFalseButton(kind: 'true' | 'false', idx: number, step: QuestionPayload): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = `pt-tf-btn pt-tf-${kind}`;
    const icon = document.createElement('span');
    icon.className = 'pt-tf-icon';
    icon.setAttribute('aria-hidden', 'true');
    icon.textContent = kind === 'true' ? '✓' : '✕';
    const label = document.createElement('span');
    label.textContent = kind === 'true' ? trueText : falseText;
    btn.appendChild(icon);
    btn.appendChild(label);
    btn.addEventListener('click', () => {
      const buttons = Array.from(optionsEl.querySelectorAll('button')) as HTMLButtonElement[];
      handleSubmit(step, { selectedIndex: idx }, buttons, btn);
    });
    return btn;
  }

  document.addEventListener('placement:register', async (event: Event) => {
    const detail = (event as CustomEvent).detail;
    const registrationError = document.getElementById('placement-registration-error') as HTMLElement | null;
    if (registrationError) registrationError.hidden = true;
    let step;
    try {
      step = await startSession(detail);
    } catch {
      if (registrationError) registrationError.hidden = false;
      return;
    }
    sessionId = step.sessionId;
    runner.classList.toggle('is-kids', step.track === 'kids');
    const registration = document.getElementById('placement-registration') as HTMLFormElement | null;
    if (registration) registration.hidden = true;
    runner.hidden = false;
    document.dispatchEvent(new CustomEvent('placement:started'));
    if (step.done) {
      document.dispatchEvent(
        new CustomEvent('placement:done', { detail: { level: step.level, levelName: step.levelName, yle: step.yle, sessionId } })
      );
      runner.hidden = true;
      return;
    }
    renderQuestion(step);
    runner.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // Local-only visual harness for checking dynamically generated question
  // controls without creating test records. Vite removes this branch from
  // production builds because import.meta.env.DEV is false there.
  if (import.meta.env.DEV) {
    const previewType = new URLSearchParams(window.location.search).get('preview-question');
    if (previewType === 'mcq' || previewType === 'text') {
      const registration = document.getElementById('placement-registration') as HTMLFormElement | null;
      if (registration) registration.hidden = true;
      runner.hidden = false;
      document.dispatchEvent(new CustomEvent('placement:started'));
      renderQuestion({
        done: false,
        questionId: 'visual-preview',
        type: previewType,
        prompt: previewType === 'mcq' ? 'Choose the answer that completes the sentence.' : 'Write the missing word.',
        options: previewType === 'mcq' ? ['I work every weekday.', 'I have other plans.', 'I am going to the park.', 'Nothing special.'] : undefined,
        questionNumber: 3,
        total: 12,
      });
    }
  }
</script>

<style>
  .card {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: 1.75rem;
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-md);
    scroll-margin-top: 6rem;
  }
  .runner-heading {
    display: flex;
    gap: 1rem;
    align-items: start;
    justify-content: space-between;
  }
  .runner-eyebrow {
    margin: 0 0 0.25rem;
    color: var(--color-primary-text);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .runner-heading h2 {
    margin: 0 0 0.45rem;
    color: var(--color-navy);
    font-size: clamp(1.45rem, 4vw, 2rem);
  }
  .runner-intro {
    max-width: 37rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.9rem;
  }
  .pt-progress-percent {
    flex: 0 0 auto;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    color: var(--color-primary-text);
    background: rgb(182 23 51 / 0.1);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .pt-progress {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .pt-progress-track {
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-surface-soft);
    overflow: hidden;
  }
  .pt-progress-fill {
    height: 100%;
    width: 0%;
    border-radius: inherit;
    background: var(--color-primary);
    transition: width var(--motion-fast) var(--ease);
  }
  .pt-skip-btn {
    justify-self: start;
    padding: 0.35rem 0;
    border: none;
    background: none;
    color: var(--color-ink-muted);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }
  .pt-skip-btn:hover:not(:disabled) {
    color: var(--color-ink);
  }
  .pt-skip-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .pt-feedback {
    margin: 0;
    padding: 0.6rem 0.9rem;
    border-radius: 0.85rem;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .pt-feedback-correct {
    background: rgb(34 139 87 / 0.12);
    color: #1a7a49;
  }
  .pt-feedback-incorrect {
    background: rgb(182 23 51 / 0.1);
    color: var(--color-primary-text);
  }
  #pt-options :global(.pt-selected-correct) {
    border-color: transparent !important;
    background: rgb(34 139 87 / 0.1) !important;
    box-shadow: inset 0 0 0 2px #1a7a49, 0 12px 28px rgb(34 139 87 / 0.14) !important;
  }
  #pt-options :global(.pt-selected-incorrect) {
    border-color: transparent !important;
    background: rgb(182 23 51 / 0.08) !important;
    box-shadow: inset 0 0 0 2px var(--color-primary), 0 12px 28px rgb(182 23 51 / 0.12) !important;
  }
  .pt-passage {
    border: 1px solid var(--color-border);
    border-inline-start: 4px solid var(--color-coral);
    border-radius: 1rem;
    background: rgb(246 173 67 / 0.08);
    padding: 0.85rem 1rem;
  }
  .pt-passage-title {
    cursor: pointer;
    margin: 0;
    color: var(--color-navy);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .pt-passage-body {
    margin: 0.65rem 0 0;
    max-height: 14rem;
    overflow-y: auto;
    color: var(--color-ink);
    font-size: 0.9rem;
    line-height: 1.55;
    white-space: pre-line;
  }
  .pt-image-stage {
    position: relative;
    isolation: isolate;
    justify-self: center;
    display: grid;
    width: min(100%, 20rem);
    min-height: 18rem;
    place-items: center;
    padding: 1.25rem;
    border: 2px solid rgb(255 255 255 / 0.85);
    border-radius: 2.25rem;
    background:
      radial-gradient(circle at 28% 20%, rgb(255 255 255 / 0.95) 0 8%, transparent 9%),
      linear-gradient(145deg, #fff4c7, #ffd98f 48%, #ffb86b);
    box-shadow:
      inset 0 2px 0 rgb(255 255 255 / 0.9),
      inset 0 -8px 18px rgb(178 92 35 / 0.16),
      0 12px 0 #df9551,
      0 22px 34px rgb(81 54 35 / 0.2);
    perspective: 700px;
  }
  .pt-image-stage[hidden] { display: none; }
  .pt-image-stage::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset-inline: 16%;
    bottom: 0.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: rgb(77 53 35 / 0.25);
    filter: blur(10px);
  }
  .pt-image {
    position: relative;
    z-index: 1;
    justify-self: center;
    width: min(100%, 15.5rem);
    height: auto;
    max-height: 15.5rem;
    object-fit: contain;
    border-radius: 50%;
    filter: drop-shadow(0 15px 10px rgb(77 53 35 / 0.28));
    transform: rotateX(4deg) rotateY(-5deg) translateY(-3px);
    transition: transform 260ms var(--ease), filter 260ms var(--ease);
  }
  .pt-image-stage:hover .pt-image {
    filter: drop-shadow(0 19px 12px rgb(77 53 35 / 0.3));
    transform: rotateX(0) rotateY(5deg) translateY(-9px) scale(1.025);
  }
  .pt-image-spark {
    position: absolute;
    z-index: 2;
    display: grid;
