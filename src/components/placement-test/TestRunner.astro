---
import type { useTranslations } from '../../i18n/ui';

export interface Props {
  t: ReturnType<typeof useTranslations>;
}
const { t } = Astro.props;
---

<section
  id="placement-test-runner"
  class="card"
  hidden
  data-question-label={t('placementTest.questionOf')}
  data-answer-error={t('placementTest.answerError')}
  data-answer-submit={t('placementTest.answerSubmit')}
  data-reading-passage={t('placementTest.readingPassage')}
  data-correct={t('placementTest.correct')}
  data-incorrect={t('placementTest.incorrect')}
  data-skip={t('placementTest.skip')}
>
  <p id="pt-progress" class="pt-progress"></p>
  <div id="pt-progress-track" class="pt-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div id="pt-progress-fill" class="pt-progress-fill"></div>
  </div>
  <details id="pt-passage" class="pt-passage" hidden>
    <summary id="pt-passage-title" class="pt-passage-title"></summary>
    <p id="pt-passage-body" class="pt-passage-body"></p>
  </details>
  <img id="pt-image" class="pt-image" alt="" hidden />
  <p id="pt-prompt" class="pt-prompt"></p>
  <div id="pt-options" class="pt-options"></div>
  <button type="button" id="pt-skip" class="pt-skip-btn"></button>
  <p id="pt-feedback" class="pt-feedback" hidden></p>
  <p id="pt-error" class="pt-error" hidden></p>
</section>

<script>
  import { startSession, submitAnswer } from '../../lib/placementApi';
  import type { QuestionPayload } from '../../lib/placementApi';

  const runner = document.getElementById('placement-test-runner') as HTMLElement;
  const progressEl = document.getElementById('pt-progress') as HTMLElement;
  const progressTrackEl = document.getElementById('pt-progress-track') as HTMLElement;
  const progressFillEl = document.getElementById('pt-progress-fill') as HTMLElement;
  const passageEl = document.getElementById('pt-passage') as HTMLDetailsElement;
  const passageTitleEl = document.getElementById('pt-passage-title') as HTMLElement;
  const passageBodyEl = document.getElementById('pt-passage-body') as HTMLElement;
  const imageEl = document.getElementById('pt-image') as HTMLImageElement;
  const promptEl = document.getElementById('pt-prompt') as HTMLElement;
  const optionsEl = document.getElementById('pt-options') as HTMLElement;
  const feedbackEl = document.getElementById('pt-feedback') as HTMLElement;
  const errorEl = document.getElementById('pt-error') as HTMLElement;
  const skipBtn = document.getElementById('pt-skip') as HTMLButtonElement;
  const questionLabel = runner.dataset.questionLabel ?? '';
  const answerErrorText = runner.dataset.answerError ?? '';
  const answerSubmitText = runner.dataset.answerSubmit ?? 'Submit';
  const readingPassageLabel = runner.dataset.readingPassage ?? 'Reading passage';
  const correctText = runner.dataset.correct ?? 'Correct!';
  const incorrectText = runner.dataset.incorrect ?? 'Incorrect';
  skipBtn.textContent = runner.dataset.skip ?? "I don't understand — skip";
  // How long the correct/incorrect feedback stays on screen before the next
  // question loads -- long enough to register, short enough not to feel like
  // a stall between questions.
  const FEEDBACK_DELAY_MS = 1100;
  let sessionId = '';
  let lastPassageId = '';

  function setProgress(questionNumber: number, total: number) {
    progressEl.textContent = total > 0 ? `${questionLabel} ${questionNumber} / ${total}` : `${questionLabel} ${questionNumber}`;
    const pct = total > 0 ? Math.min(100, Math.round((questionNumber / total) * 100)) : 0;
    progressFillEl.style.width = `${pct}%`;
    progressTrackEl.setAttribute('aria-valuenow', String(pct));
  }

  function showFeedback(correct: boolean | undefined, selectedEl: HTMLElement | null) {
    if (correct === undefined) {
      feedbackEl.hidden = true;
      return;
    }
    feedbackEl.hidden = false;
    feedbackEl.textContent = correct ? correctText : incorrectText;
    feedbackEl.className = `pt-feedback ${correct ? 'pt-feedback-correct' : 'pt-feedback-incorrect'}`;
    selectedEl?.classList.add(correct ? 'pt-selected-correct' : 'pt-selected-incorrect');
  }

  async function handleSubmit(
    step: QuestionPayload,
    answer: { selectedIndex: number } | { answerText: string } | { skip: true },
    disabledEls: Array<HTMLButtonElement | HTMLInputElement>,
    selectedEl: HTMLElement | null
  ) {
    disabledEls.forEach((el) => (el.disabled = true));
    skipBtn.disabled = true;
    errorEl.hidden = true;
    try {
      const next = await submitAnswer(sessionId, step.questionId, answer);
      showFeedback(next.correct, selectedEl);
      window.setTimeout(
        () => {
          if (next.done) {
            progressFillEl.style.width = '100%';
            document.dispatchEvent(new CustomEvent('placement:done', { detail: { level: next.level, levelName: next.levelName, sessionId } }));
            runner.hidden = true;
          } else {
            renderQuestion(next);
          }
        },
        next.correct === undefined ? 0 : FEEDBACK_DELAY_MS
      );
    } catch {
      // Network/API failure mid-test: re-enable the inputs and show an inline error
      // instead of leaving a frozen, unresponsive question card.
      errorEl.textContent = answerErrorText;
      errorEl.hidden = false;
      disabledEls.forEach((el) => (el.disabled = false));
      skipBtn.disabled = false;
    }
  }

  function renderQuestion(step: QuestionPayload) {
    setProgress(step.questionNumber, step.total);
    feedbackEl.hidden = true;
    skipBtn.disabled = false;
    // Re-bound each render (rather than once) so the closure always skips
    // *this* question's id and disables *this* question's currently-rendered
    // inputs, whatever type they are.
    skipBtn.onclick = () => {
      const inputEls = Array.from(optionsEl.querySelectorAll('button, input')) as Array<HTMLButtonElement | HTMLInputElement>;
      handleSubmit(step, { skip: true }, inputEls, null);
    };

    if (step.passage) {
      passageEl.hidden = false;
      passageTitleEl.textContent = `${readingPassageLabel}: ${step.passage.title}`;
      passageBodyEl.textContent = step.passage.body;
      // Auto-expand only the first question of a new passage; once the student has
      // opened or closed it, later questions sharing that same passage leave the
      // <details> state alone instead of forcing it back open every render.
      if (step.passage.id !== lastPassageId) {
        passageEl.open = true;
        lastPassageId = step.passage.id;
      }
    } else {
      passageEl.hidden = true;
      lastPassageId = '';
    }

    if (step.imageUrl) {
      imageEl.src = step.imageUrl;
      imageEl.hidden = false;
    } else {
      imageEl.hidden = true;
      imageEl.removeAttribute('src');
    }
    promptEl.textContent = step.prompt;
    optionsEl.innerHTML = '';
    errorEl.hidden = true;

    if (step.type === 'text') {
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'pt-text-input';
      input.autocomplete = 'off';
      input.autocapitalize = 'off';
      input.spellcheck = false;
      const submitBtn = document.createElement('button');
      submitBtn.type = 'button';
      submitBtn.className = 'btn btn-primary';
      submitBtn.textContent = answerSubmitText;
      submitBtn.addEventListener('click', () => {
        if (!input.value.trim()) return;
        handleSubmit(step, { answerText: input.value }, [input, submitBtn], input);
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') submitBtn.click();
      });
      optionsEl.appendChild(input);
      optionsEl.appendChild(submitBtn);
      input.focus();
      return;
    }

    const options = step.options ?? [];
    // True/false reading-comprehension items are still plain 2-option mcq rows
    // in the DB (grading is identical to any other mcq), but they read better
    // as a distinct True/False choice than as a vertical 4-option-style list.
    const isTrueFalse = options.length === 2 && options[0] === 'True' && options[1] === 'False';

    if (isTrueFalse) {
      optionsEl.classList.add('pt-options-tf');
      const trueBtn = makeTrueFalseButton('true', 0, step);
      const falseBtn = makeTrueFalseButton('false', 1, step);
      optionsEl.appendChild(trueBtn);
      optionsEl.appendChild(falseBtn);
      return;
    }
    optionsEl.classList.remove('pt-options-tf');

    options.forEach((opt: string, idx: number) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn btn-outline';
      btn.textContent = opt;
      btn.addEventListener('click', () => {
        const buttons = Array.from(optionsEl.querySelectorAll('button')) as HTMLButtonElement[];
        handleSubmit(step, { selectedIndex: idx }, buttons, btn);
      });
      optionsEl.appendChild(btn);
    });
  }

  function makeTrueFalseButton(kind: 'true' | 'false', idx: number, step: QuestionPayload): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = `pt-tf-btn pt-tf-${kind}`;
    const icon = document.createElement('span');
    icon.className = 'pt-tf-icon';
    icon.setAttribute('aria-hidden', 'true');
    icon.textContent = kind === 'true' ? '✓' : '✕';
    const label = document.createElement('span');
    label.textContent = kind === 'true' ? 'True' : 'False';
    btn.appendChild(icon);
    btn.appendChild(label);
    btn.addEventListener('click', () => {
      const buttons = Array.from(optionsEl.querySelectorAll('button')) as HTMLButtonElement[];
      handleSubmit(step, { selectedIndex: idx }, buttons, btn);
    });
    return btn;
  }

  document.addEventListener('placement:register', async (event: Event) => {
    const detail = (event as CustomEvent).detail;
    const step = await startSession(detail);
    sessionId = step.sessionId;
    runner.hidden = false;
    if (step.done) {
      document.dispatchEvent(
        new CustomEvent('placement:done', { detail: { level: step.level, levelName: step.levelName, sessionId } })
      );
      runner.hidden = true;
      return;
    }
    renderQuestion(step);
  });
</script>

<style>
  .card {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-sm);
  }
  .pt-progress {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .pt-progress-track {
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-surface-soft);
    overflow: hidden;
  }
  .pt-progress-fill {
    height: 100%;
    width: 0%;
    border-radius: inherit;
    background: var(--color-primary);
    transition: width var(--motion-fast) var(--ease);
  }
  .pt-skip-btn {
    justify-self: start;
    padding: 0.35rem 0;
    border: none;
    background: none;
    color: var(--color-ink-muted);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }
  .pt-skip-btn:hover:not(:disabled) {
    color: var(--color-ink);
  }
  .pt-skip-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .pt-feedback {
    margin: 0;
    padding: 0.6rem 0.9rem;
    border-radius: 0.85rem;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .pt-feedback-correct {
    background: rgb(34 139 87 / 0.12);
    color: #1a7a49;
  }
  .pt-feedback-incorrect {
    background: rgb(182 23 51 / 0.1);
    color: var(--color-primary-text);
  }
  .pt-selected-correct {
    border-color: #1a7a49 !important;
    background: rgb(34 139 87 / 0.14) !important;
  }
  .pt-selected-incorrect {
    border-color: var(--color-primary) !important;
    background: rgb(182 23 51 / 0.1) !important;
  }
  .pt-passage {
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    background: var(--color-surface-soft);
    padding: 0.6rem 0.9rem;
  }
  .pt-passage-title {
    cursor: pointer;
    margin: 0;
    color: var(--color-navy);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .pt-passage-body {
    margin: 0.65rem 0 0;
    max-height: 14rem;
    overflow-y: auto;
    color: var(--color-ink);
    font-size: 0.9rem;
    line-height: 1.55;
    white-space: pre-line;
  }
  .pt-image {
    justify-self: center;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
  }
  .pt-prompt {
    margin: 0;
    color: var(--color-navy);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .pt-options {
    display: grid;
    gap: 0.65rem;
  }
  .pt-error {
    margin: 0;
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .pt-text-input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    color: var(--color-ink);
    background: var(--color-surface-soft);
    font: inherit;
  }
  .pt-text-input:focus {
    outline: 3px solid rgb(182 23 51 / 0.12);
    border-color: var(--color-primary);
  }
  .pt-options-tf {
    grid-template-columns: 1fr 1fr;
  }
  .pt-tf-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    background: var(--color-surface-soft);
    color: var(--color-ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--ease), background var(--motion-fast) var(--ease),
      color var(--motion-fast) var(--ease);
  }
  .pt-tf-icon {
    display: inline-flex;
    width: 1.6rem;
    height: 1.6rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 1rem;
    line-height: 1;
  }
  .pt-tf-true .pt-tf-icon {
    background: rgb(34 139 87 / 0.14);
    color: #1a7a49;
  }
  .pt-tf-false .pt-tf-icon {
    background: rgb(182 23 51 / 0.1);
    color: var(--color-primary-text);
  }
  .pt-tf-btn:hover:not(:disabled) {
    border-color: var(--color-primary);
  }
  .pt-tf-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }
</style>
