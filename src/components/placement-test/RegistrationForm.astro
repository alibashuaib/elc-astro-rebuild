---
import type { Locale, useTranslations } from '../../i18n/ui';

export interface Props {
  locale: Locale;
  t: ReturnType<typeof useTranslations>;
}
const { locale, t } = Astro.props;
---

<form id="placement-registration" class="card" data-locale={locale}>
  <fieldset class="track-field">
    <legend>{t('placementTest.formTrack')}</legend>
    <div class="track-toggle">
      <label class="track-pill">
        <input required name="track" type="radio" value="adults" checked />
        <span>{t('placementTest.formTrackAdults')}</span>
      </label>
      <label class="track-pill">
        <input required name="track" type="radio" value="kids" />
        <span>{t('placementTest.formTrackKids')}</span>
      </label>
    </div>
  </fieldset>
  <label>
    {t('placementTest.formName')}
    <input required name="name" type="text" autocomplete="name" />
  </label>
  <label>
    {t('placementTest.formPhone')}
    <input class="numeric" required name="phone" type="tel" autocomplete="tel" inputmode="tel" />
  </label>
  <label>
    {t('placementTest.formDob')}
    <input required name="dob" type="date" />
  </label>
  <label id="guardian-field" hidden>
    {t('placementTest.formGuardian')}
    <input name="guardianName" type="text" autocomplete="name" />
  </label>
  <button type="submit" class="btn btn-primary">{t('placementTest.formSubmit')}</button>
</form>

<script>
  const form = document.getElementById('placement-registration') as HTMLFormElement;
  const trackInputs = form.querySelectorAll<HTMLInputElement>('input[name="track"]');
  const guardianField = document.getElementById('guardian-field') as HTMLElement;

  function selectedTrack(): string {
    return (form.querySelector<HTMLInputElement>('input[name="track"]:checked'))?.value ?? 'adults';
  }

  function updateGuardianField() {
    const isKids = selectedTrack() === 'kids';
    guardianField.hidden = !isKids;
    const guardianInput = guardianField.querySelector<HTMLInputElement>('input')!;
    guardianInput.required = isKids;
  }

  trackInputs.forEach((input) => input.addEventListener('change', updateGuardianField));
  updateGuardianField();

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    document.dispatchEvent(
      new CustomEvent('placement:register', { detail: { ...data, locale: form.dataset.locale } })
    );
  });
</script>

<style>
  .card {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-sm);
  }
  .card label {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: var(--color-navy);
    font-size: 0.88rem;
    font-weight: 700;
  }
  .card input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    color: var(--color-ink);
    background: var(--color-surface-soft);
    font: inherit;
  }
  .card input:focus {
    outline: 3px solid rgb(182 23 51 / 0.12);
    border-color: var(--color-primary);
  }
  .card .btn {
    justify-content: center;
    margin-top: 0.5rem;
  }
  .track-field {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    border: none;
  }
  .track-field legend {
    padding: 0;
    color: var(--color-navy);
    font-size: 0.88rem;
    font-weight: 700;
  }
  .track-toggle {
    display: flex;
    gap: 0.5rem;
  }
  /* `.card label.track-pill` (not just `.track-pill`) so this beats the
     generic `.card label` rule's flex-direction/gap on specificity instead
     of losing to it silently. */
  .card label.track-pill {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.9rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-ink-muted);
    background: var(--color-surface-soft);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease),
      color var(--motion-fast) var(--ease);
  }
  .track-pill input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  /* Same `.card label.track-pill` prefix as the base rule above, plus
     :has() -- otherwise this loses the specificity fight to that base rule's
     own color/background instead of overriding it on check. */
  .card label.track-pill:has(input:checked) {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #fff;
  }
  .card label.track-pill:has(input:focus-visible) {
    outline: 3px solid rgb(182 23 51 / 0.12);
    outline-offset: 2px;
  }
</style>
