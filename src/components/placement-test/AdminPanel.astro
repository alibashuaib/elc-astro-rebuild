---
// src/components/placement-test/AdminPanel.astro
// Staff-only tool — plain hardcoded English strings (no i18n needed, see task report).
---

<section id="admin-login" class="card">
  <h2>Admin login</h2>
  <label>
    Username
    <input id="admin-username" type="text" autocomplete="username" />
  </label>
  <label>
    Password
    <input id="admin-password" type="password" autocomplete="current-password" />
  </label>
  <button id="admin-login-btn" type="button" class="btn btn-primary">Log in</button>
  <p id="admin-login-error" class="admin-error" role="alert" hidden>Wrong username or password. Please try again.</p>
</section>

<section id="admin-dashboard" class="dashboard" hidden>
  <div class="card">
    <h2>Slots</h2>
    <form id="slot-form" class="slot-form">
      <label>
        Starts at (Riyadh time)
        <input id="slot-starts-at" type="datetime-local" required />
      </label>
      <label>
        Capacity
        <input id="slot-capacity" type="number" min="1" value="4" required />
      </label>
      <button type="submit" class="btn btn-primary">Add slot</button>
    </form>
    <ul id="slot-list" class="admin-list"></ul>
  </div>

  <div class="card">
    <h2>Upcoming bookings</h2>
    <ul id="booking-list" class="admin-list"></ul>
  </div>

  <div class="card">
    <h2>Applications</h2>
    <label>
      Filter by status
      <select id="application-status-filter">
        <option value="">All</option>
        <option value="pending">Pending</option>
        <option value="approved">Approved</option>
        <option value="rejected">Rejected</option>
      </select>
    </label>
    <ul id="application-list" class="admin-list"></ul>
  </div>
  <div class="card">
    <h2>Question bank</h2>
    <form id="question-form" class="question-form">
      <label>
        Track
        <select id="question-track" required>
          <option value="kids">Kids</option>
          <option value="adults">Adults</option>
        </select>
      </label>
      <label>
        Level
        <select id="question-level" required></select>
      </label>
      <label>
        Prompt
        <input id="question-prompt" type="text" required />
      </label>
      <label>
        Option 1
        <input id="question-option-0" type="text" required />
      </label>
      <label>
        Option 2
        <input id="question-option-1" type="text" required />
      </label>
      <label>
        Option 3
        <input id="question-option-2" type="text" required />
      </label>
      <label>
        Option 4
        <input id="question-option-3" type="text" required />
      </label>
      <label>
        Correct option
        <select id="question-correct-index" required>
          <option value="0">Option 1</option>
          <option value="1">Option 2</option>
          <option value="2">Option 3</option>
          <option value="3">Option 4</option>
        </select>
      </label>
      <button type="submit" class="btn btn-primary">Add question</button>
    </form>
    <ul id="question-list" class="admin-list"></ul>
  </div>

</section>

<script>
  const BASE = import.meta.env.PUBLIC_PLACEMENT_API_URL as string;

  async function api(path: string, init?: RequestInit) {
    const res = await fetch(`${BASE}${path}`, {
      ...init,
      credentials: 'include',
      headers: { 'content-type': 'application/json', ...(init?.headers ?? {}) },
    });
    if (!res.ok) throw new Error(`${path} failed: ${res.status}`);
    return res.status === 204 ? null : res.json();
  }

  document.getElementById('admin-login-btn')!.addEventListener('click', async () => {
    const username = (document.getElementById('admin-username') as HTMLInputElement).value;
    const password = (document.getElementById('admin-password') as HTMLInputElement).value;
    document.getElementById('admin-login-error')!.hidden = true;
    try {
      await api('/api/admin/login', { method: 'POST', body: JSON.stringify({ username, password }) });
      document.getElementById('admin-login')!.setAttribute('hidden', '');
      document.getElementById('admin-dashboard')!.removeAttribute('hidden');
      await loadAll();
    } catch {
      const error = document.getElementById('admin-login-error')!;
      error.hidden = false;
      (document.getElementById('admin-password') as HTMLInputElement).focus();
    }
  });

  // UI-23: the centre runs on Riyadh time (UTC+3, no DST), whatever the staff device is set to.
  const riyadh = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Riyadh', weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' });
  const when = (iso: string) => riyadh.format(new Date(iso));
  // UI-25 / ADM-03: show only the last 4 characters of an ID number.
  const maskId = (id: string) => (id.length > 4 ? `${'•'.repeat(id.length - 4)}${id.slice(-4)}` : id);

  async function loadAll() {
    const [{ slots }, { bookings }, { questions }, { applications }] = await Promise.all([
      api('/api/admin/slots'),
      api('/api/admin/bookings'),
      api('/api/admin/questions'),
      api(`/api/admin/applications${statusFilter.value ? `?status=${statusFilter.value}` : ''}`),
    ]);

    const slotList = document.getElementById('slot-list')!;
    slotList.innerHTML = '';
    slots.forEach((s: any) => {
      const li = document.createElement('li');
      li.textContent = `${when(s.starts_at)} — ${s.booked_count}/${s.capacity} booked `;
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn btn-outline';
      del.textContent = 'Delete';
      del.addEventListener('click', async () => {
        if (!confirm(`Delete the slot on ${when(s.starts_at)}?`)) return;
        const res = await fetch(`${BASE}/api/admin/slots/${s.id}`, { method: 'DELETE', credentials: 'include' });
        if (res.status === 409) {
          alert('This slot has confirmed bookings and cannot be deleted.');
          return;
        }
        if (!res.ok) {
          alert('Delete failed.');
          return;
        }
        loadAll();
      });
      li.appendChild(del);
      slotList.appendChild(li);
    });

    const bookingList = document.getElementById('booking-list')!;
    bookingList.innerHTML = '';
    bookings.forEach((b: any) => {
      const li = document.createElement('li');
      li.textContent = `${b.student_name} (${b.phone}) — level ${b.estimated_level} — ${when(b.starts_at)}`;
      bookingList.appendChild(li);
    });

    const questionList = document.getElementById('question-list')!;
    questionList.innerHTML = '';
    questions.forEach((q: any) => {
      const li = document.createElement('li');
      li.textContent = `[${q.track}/${q.level}] ${q.prompt} ${q.active ? '' : '(inactive)'} `;
      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'btn btn-outline';
      toggle.textContent = q.active ? 'Deactivate' : 'Activate';
      toggle.addEventListener('click', async () => {
        if (!confirm(`${q.active ? 'Deactivate' : 'Activate'} this question?`)) return;
        await api(`/api/admin/questions/${q.id}`, { method: 'PATCH', body: JSON.stringify({ active: !q.active }) });
        loadAll();
      });
      li.appendChild(toggle);
      questionList.appendChild(li);
    });

    const applicationList = document.getElementById('application-list')!;
    applicationList.innerHTML = '';
    const idTypeLabels: Record<string, string> = { national_id: 'National ID', iqama: 'Iqama', passport: 'Passport' };
    applications.forEach((a: any) => {
      const li = document.createElement('li');
      const summary = document.createElement('div');
      summary.className = 'admin-row';
      const idTypeLabel = idTypeLabels[a.id_type] ?? a.id_type;
      const name = document.createElement('strong');
      name.textContent = `${a.student_name} · ${a.status}`;
      const details = document.createElement('span');
      details.textContent = `${a.course} · level ${a.estimated_level ?? '—'} · ${a.phone} · ${a.email} · ${idTypeLabel} ${maskId(String(a.id_number ?? ''))}`;
      summary.append(name, details);
      li.appendChild(summary);

      if (a.status === 'pending') {
        const approve = document.createElement('button');
        approve.type = 'button';
        approve.className = 'btn btn-primary';
        approve.textContent = 'Approve';
        approve.addEventListener('click', async () => {
          if (!confirm(`Approve ${a.student_name}'s application? This cannot be undone here.`)) return;
          await api(`/api/admin/applications/${a.application_id}`, { method: 'PATCH', body: JSON.stringify({ status: 'approved' }) });
          loadAll();
        });
        const reject = document.createElement('button');
        reject.type = 'button';
        reject.className = 'btn btn-outline';
        reject.textContent = 'Reject';
        reject.addEventListener('click', async () => {
          if (!confirm(`Reject ${a.student_name}'s application? This cannot be undone here.`)) return;
          await api(`/api/admin/applications/${a.application_id}`, { method: 'PATCH', body: JSON.stringify({ status: 'rejected' }) });
          loadAll();
        });
        li.appendChild(approve);
        li.appendChild(reject);
      }

      applicationList.appendChild(li);
    });
  }

  document.getElementById('slot-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const startsAt = (document.getElementById('slot-starts-at') as HTMLInputElement).value;
    const capacity = Number((document.getElementById('slot-capacity') as HTMLInputElement).value);
    await api('/api/admin/slots', {
      method: 'POST',
      body: JSON.stringify({ startsAt: new Date(`${startsAt}:00+03:00`).toISOString(), capacity }),
    });
    await loadAll();
  });

  // ELC's own level ladders (see scoring.ts/LEVELS_BY_TRACK in placement-test-worker
  // and the "Adults Structure" / "General English for Kids" curricular-structure
  // diagrams) -- not the generic CEFR A1-C2 scale. Adults top out at C1 (no C2);
  // kids only reach B1, with an extra sub-level between A1 and A2.
  const LEVELS_BY_TRACK: Record<string, string[]> = {
    adults: ['A0', 'A1', 'A2', 'B1', 'B2', 'C1'],
    kids: ['-A1', 'A1', 'A1+', 'A2', 'A2+', 'B1'],
  };
  const trackSelect = document.getElementById('question-track') as HTMLSelectElement;
  const levelSelect = document.getElementById('question-level') as HTMLSelectElement;
  const statusFilter = document.getElementById('application-status-filter') as HTMLSelectElement;
  statusFilter.addEventListener('change', loadAll);
  function refreshLevelOptions() {
    const levels = LEVELS_BY_TRACK[trackSelect.value] ?? [];
    levelSelect.innerHTML = levels.map((l) => `<option value="${l}">${l}</option>`).join('');
  }
  trackSelect.addEventListener('change', refreshLevelOptions);
  refreshLevelOptions();

  document.getElementById('question-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const track = (document.getElementById('question-track') as HTMLSelectElement).value;
    const level = (document.getElementById('question-level') as HTMLSelectElement).value;
    const prompt = (document.getElementById('question-prompt') as HTMLInputElement).value;
    const options = [0, 1, 2, 3].map(
      (i) => (document.getElementById(`question-option-${i}`) as HTMLInputElement).value
    );
    const correctIndex = Number((document.getElementById('question-correct-index') as HTMLSelectElement).value);
    await api('/api/admin/questions', {
      method: 'POST',
      body: JSON.stringify({ track, level, prompt, options, correctIndex }),
    });
    (document.getElementById('question-form') as HTMLFormElement).reset();
    await loadAll();
  });
</script>

<style>
  .card {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-sm);
  }
  .card h2 {
    margin: 0;
    color: var(--color-navy);
    font-size: 1.1rem;
  }
  .card label {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: var(--color-navy);
    font-size: 0.88rem;
    font-weight: 700;
  }
  .card input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    color: var(--color-ink);
    background: var(--color-surface-soft);
    font: inherit;
  }
  .card input:focus {
    outline: 3px solid rgb(182 23 51 / 0.12);
    border-color: var(--color-primary);
  }
  .card .btn {
    justify-content: center;
  }

  .dashboard {
    display: grid;
    gap: 1.5rem;
  }

  .slot-form {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    align-items: end;
  }

  .question-form {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    margin-bottom: 1rem;
  }
  .card select {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    color: var(--color-ink);
    background: var(--color-surface-soft);
    font: inherit;
  }
  .question-form button {
    grid-column: 1 / -1;
  }
  @media (max-width: 40rem) {
    .slot-form,
    .question-form {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .card,
  .card label {
    min-width: 0;
  }
  .admin-error {
    margin: 0;
    color: var(--color-primary-text);
    font-weight: 600;
  }
  .admin-list :global(.admin-row) {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    flex: 1 1 16rem;
  }
  .admin-list :global(.admin-row span) {
    color: var(--color-ink-subtle);
  }

  .admin-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Rows are built in the script, so they need :global() to get these styles. */
  .admin-list :global(li) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface-soft);
    color: var(--color-ink);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
</style>
