---
import { Image } from 'astro:assets';
import logoFull from '../assets/logo-elc-full.png';
import { useTranslations, localizePath, alternateLocale, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** current path with locale prefix stripped, e.g. "/courses" — used to build the language-switch link */
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = useTranslations(locale);
const otherLocale = alternateLocale(locale);
const languageLabel = otherLocale === 'ar' ? 'العربية' : 'English';
---

<header class="site-header">
  <div class="container header-inner">
    <a href={localizePath(locale, '/')} class="logo" aria-label={locale === 'ar' ? 'الصفحة الرئيسية لمعهد صرح المعرفة' : 'ELC homepage'}>
      <Image src={logoFull} alt={locale === 'ar' ? 'معهد صرح المعرفة' : 'ELC — English Learning Centre'} width={112} densities={[1, 2]} class="logo-full" />
    </a>

    <nav class="main-nav" id="main-nav" aria-label={t('nav.menu')}>
      <ul>
        <li><a href={localizePath(locale, '/about')} aria-current={currentPath === '/about' ? 'page' : undefined}>{t('nav.about')}</a></li>
        <li><a href={localizePath(locale, '/courses')} aria-current={currentPath.startsWith('/courses') ? 'page' : undefined}>{t('nav.courses')}</a></li>
        <li><a href={localizePath(locale, '/blog')} aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>{t('nav.blog')}</a></li>
        <li><a href={localizePath(locale, '/contact')} aria-current={currentPath === '/contact' ? 'page' : undefined}>{t('nav.contact')}</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a
        href="https://elc-org.com"
        target="_blank"
        rel="noopener"
        class="btn btn-outline lms-btn"
      >
        {t('nav.lms')}
      </a>
      <a href={localizePath(locale, '/register')} class="btn btn-primary">{t('nav.register')}</a>
      <a
        href={localizePath(otherLocale, currentPath)}
        class="lang-switch"
        hreflang={otherLocale}
        lang={otherLocale}
        aria-label={languageLabel}
        title={languageLabel}
      >
        {otherLocale === 'ar' ? (
          <svg class="flag-icon" viewBox="0 0 36 24" aria-hidden="true" role="img">
            <rect width="36" height="24" rx="2" fill="#006c35" />
            <path d="M9 8.2h18M10.5 10.5h15M11.5 12.8h13" stroke="#fff" stroke-width="1.15" stroke-linecap="round" />
            <path d="M9 16.8c5.7 1.1 12.7 1 18-.35M24.5 15.7l2.5.75-2.15 1.2" fill="none" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        ) : (
          <svg class="flag-icon" viewBox="0 0 36 24" aria-hidden="true" role="img">
            <rect width="36" height="24" rx="2" fill="#21468b" />
            <path d="M0 0 36 24M36 0 0 24" stroke="#fff" stroke-width="5" />
            <path d="M0 0 36 24M36 0 0 24" stroke="#cf142b" stroke-width="2" />
            <path d="M18 0v24M0 12h36" stroke="#fff" stroke-width="7" />
            <path d="M18 0v24M0 12h36" stroke="#cf142b" stroke-width="4" />
          </svg>
        )}
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label={t('nav.menu')}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / .9);
    border-bottom: 1px solid rgb(228 223 218 / .85);
    box-shadow: 0 8px 35px rgb(49 43 40 / .05);
    backdrop-filter: blur(18px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 5.25rem;
    padding-block: .85rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .logo-full {
    display: block;
    width: 7rem;
    height: auto;
  }
  .main-nav ul {
    display: flex;
    gap: .35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    display: inline-flex;
    padding: .55rem .72rem;
    border-radius: 999px;
    color: var(--color-ink-muted);
    font-size: .84rem;
    font-weight: 650;
  }
  .main-nav a:hover, .main-nav a[aria-current='page'] { color: var(--color-primary); background: var(--color-blue-soft); text-decoration: none; }
  .header-actions {
    display: flex;
    align-items: center;
    gap: .65rem;
  }
  .lang-switch {
    border: 1px solid var(--color-border);
    display: grid;
    place-items: center;
    width: 2.65rem;
    height: 2.65rem;
    border-radius: 999px;
    padding: .45rem;
    background: #fff;
    box-shadow: 0 7px 18px rgb(49 43 40 / .08);
    transition: transform var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease), box-shadow var(--motion-fast) var(--ease);
  }
  .lang-switch:hover { border-color: rgb(182 23 51 / .34); text-decoration: none; transform: translateY(-2px); box-shadow: 0 10px 24px rgb(49 43 40 / .13); }
  .flag-icon { display: block; width: 1.6rem; height: auto; overflow: hidden; border-radius: .14rem; box-shadow: 0 0 0 1px rgb(25 39 69 / .12); }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    padding: var(--space-2);
    cursor: pointer;
  }
  .nav-toggle span {
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-navy);
  }

  /* Mobile: this is the exact bug the audit flagged — mobile nav must never silently fail */
  @media (max-width: 860px) {
    .main-nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      padding: .5rem var(--space-4) var(--space-4);
      /* Solid, not translucent: this panel overlays page content directly (no
         blur fallback if backdrop-filter isn't supported/rendered), so partial
         opacity here lets text underneath show through. */
      background: #fff;
      border-bottom: 1px solid var(--color-border);
      display: none;
    }
    .main-nav.open { display: block; }
    .main-nav ul {
      flex-direction: column;
      gap: 0;
      padding: var(--space-3);
      border: 1px solid var(--color-border);
      border-radius: 1.25rem;
      box-shadow: var(--shadow-md);
    }
    .main-nav li { padding: .15rem; }
    .main-nav a { display: flex; padding: .75rem 1rem; }
    .lms-btn, .btn-primary { display: none; }
    .nav-toggle { display: flex; }
  }
</style>

<script src="/scripts/mobile-nav.js" defer></script>
