---
import { useTranslations, localizePath, alternateLocale, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** current path with locale prefix stripped, e.g. "/courses" — used to build the language-switch link */
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = useTranslations(locale);
const otherLocale = alternateLocale(locale);
---

<header class="site-header">
  <div class="container header-inner">
    <a href={localizePath(locale, '/')} class="logo" aria-label="ELC">
      ELC
    </a>

    <nav class="main-nav" id="main-nav" aria-label={t('nav.menu')}>
      <ul>
        <li><a href={localizePath(locale, '/')}>{t('nav.home')}</a></li>
        <li><a href={localizePath(locale, '/courses')}>{t('nav.courses')}</a></li>
        <li><a href={localizePath(locale, '/about')}>{t('nav.about')}</a></li>
        <li><a href={localizePath(locale, '/why-elc')}>{t('nav.compare')}</a></li>
        <li><a href={localizePath(locale, '/blog')}>{t('nav.blog')}</a></li>
        <li><a href={localizePath(locale, '/contact')}>{t('nav.contact')}</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a
        href="https://elc-org.com"
        target="_blank"
        rel="noopener"
        class="btn btn-outline lms-btn"
      >
        {t('nav.lms')}
      </a>
      <a href={localizePath(locale, '/register')} class="btn btn-primary">{t('nav.register')}</a>
      <a href={localizePath(otherLocale, currentPath)} class="lang-switch" hreflang={otherLocale}>
        {otherLocale.toUpperCase()}
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label={t('nav.menu')}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg-raised);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-lg);
    color: var(--color-crimson-text);
    text-decoration: none;
  }
  .main-nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    color: var(--color-ink);
    font-weight: 500;
  }
  .main-nav a:hover { color: var(--color-crimson-text); }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .lang-switch {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.2rem 0.5rem;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    padding: var(--space-2);
    cursor: pointer;
  }
  .nav-toggle span {
    width: 22px;
    height: 2px;
    background: var(--color-ink);
  }

  /* Mobile: this is the exact bug the audit flagged — mobile nav must never silently fail */
  @media (max-width: 860px) {
    .main-nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--color-bg-raised);
      border-bottom: 1px solid var(--color-border);
      display: none;
    }
    .main-nav.open { display: block; }
    .main-nav ul {
      flex-direction: column;
      gap: 0;
      padding: var(--space-3) var(--space-4);
    }
    .main-nav li { padding-block: var(--space-2); }
    .lms-btn, .btn-primary { display: none; }
    .nav-toggle { display: flex; }
  }
</style>

<script src="/scripts/mobile-nav.js" defer></script>
