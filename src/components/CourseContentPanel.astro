---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  Content: any;
}

const { locale, Content } = Astro.props;
const isArabic = locale === 'ar';
---

<section class="program-section" aria-label={isArabic ? 'تفاصيل البرنامج' : 'Program details'}>
  <header class="program-heading">
    <span class="program-icon"><Icon name="details" size={24} /></span>
    <div>
      <p>{isArabic ? 'عن البرنامج' : 'Inside the program'}</p>
      <strong>{isArabic ? 'تجربة تعليمية واضحة ومنظمة' : 'A clear, structured learning experience'}</strong>
    </div>
  </header>

  <div class="tabs-wrapper">
    <div class="tabs-nav" role="tablist">
      {/* Tabs will be generated by JavaScript based on h2 headings */}
    </div>
    <div class="tabs-content">
      <div class="prose course-prose" data-tabs-container>
        <Content />
      </div>
    </div>
  </div>
</section>

<script>
  function initializeTabs() {
    const containers = document.querySelectorAll('[data-tabs-container]');

    containers.forEach((container) => {
      const section = container.closest('.program-section');
      if (!section) return;

      const tabsNav = section.querySelector('.tabs-nav');
      if (!tabsNav) return;

      // Find all h2 headings in the prose
      const headings = container.querySelectorAll(':scope > h2');
      if (headings.length < 2) return; // Only enable tabs if 2+ sections

      const tabs: Array<{ heading: Element; content: Element[] }> = [];

      let progressionStep = 0;
      const course = section.closest('[data-course]')?.getAttribute('data-course') ?? '';
      const adultDiagram = ['adults-general', 'womens-general-english'].includes(course);
      const kidsDiagram = course === 'kids-general';
      const stepDiagram = course === 'step-exam-preparation';
      const progressionImages = ['foundation', 'communication', 'growth', 'independence', 'progress', 'fluency', 'next-step'];
      const progressionStages = document.documentElement.lang === 'ar'
        ? ['المستوى 0 · التأسيس', 'أولى المحادثات', 'مهارات تتوسع', 'استخدام مستقل', 'تواصل بثقة', 'طلاقة أكبر', 'جاهز للخطوة التالية']
        : ['Level 0 · Foundations', 'Communication', 'Growth', 'Independence', 'Progress', 'Fluency', 'Next step'];
      const adultStages = document.documentElement.lang === 'ar'
        ? ['التأسيس · A0–A1', 'ما قبل المتوسط · A1–A2', 'المتوسط المتقدم · B1–B2', 'المتقدم · B2–C1']
        : ['Fundamentals · A0–A1', 'Low Intermediate · A1–A2', 'High Intermediate · B1–B2', 'Advanced · B2–C1'];
      const fullWidthHeading = /our teaching philosophy|teaching approach|our instructors|طريقتنا في التعليم|أسلوب التدريس|فريق التدريس/i;
      headings.forEach((heading, index) => {
        const id = `tab-${index}-${Math.random().toString(36).slice(2, 9)}`;
        heading.id = id;
        const isProgression = /course progression|course diagram|رحلة التعلّم|مخطط الدورة/i.test(heading.textContent ?? '');
        if (isProgression && adultDiagram) section.classList.add('adult-diagram');
        if (isProgression && kidsDiagram) section.classList.add('kids-diagram');
        if (isProgression && stepDiagram) section.classList.add('step-diagram');
        let isTeachingPhilosophy = fullWidthHeading.test(heading.textContent ?? '');
        heading.classList.toggle('progression-heading', isProgression);

        // Collect content until next heading
        const content: Element[] = [];
        let sibling = heading.nextElementSibling;
        while (sibling && sibling.tagName !== 'H2') {
          if (sibling.tagName === 'H3') isTeachingPhilosophy = fullWidthHeading.test(sibling.textContent ?? '');
          sibling.classList.toggle('full-width-copy', isTeachingPhilosophy);
          const isProgressionCard = isProgression && sibling.tagName === 'P';
          sibling.classList.toggle('progression-card', isProgressionCard);
          if (isProgressionCard) {
            progressionStep += 1;
            const stage = adultDiagram ? (progressionStep <= 3 ? 1 : progressionStep <= 8 ? 2 : progressionStep <= 13 ? 3 : 4) : stepDiagram ? progressionStep : Math.ceil(progressionStep / 2);
            sibling.setAttribute('data-stage', String(stage));
            if (adultDiagram) {
              sibling.setAttribute('data-step', String(progressionStep - 1).padStart(2, '0'));
              if ([3, 8, 13, 16].includes(progressionStep)) sibling.classList.add('band-end');
            }
            if (kidsDiagram) sibling.setAttribute('data-step', progressionStep <= 2 ? `00${progressionStep === 1 ? 'A' : 'B'}` : String(progressionStep - 2).padStart(2, '0'));
            if (stepDiagram) sibling.setAttribute('data-step', String(progressionStep).padStart(2, '0'));
            if (!stepDiagram && (adultDiagram ? [1, 4, 9, 14].includes(progressionStep) : progressionStep % 2 === 1)) {
              const divider = document.createElement('div');
              divider.className = 'progression-divider';
              divider.setAttribute('data-stage', String(stage));
              divider.textContent = (adultDiagram ? adultStages : progressionStages)[stage - 1];
              sibling.before(divider);
              content.push(divider);
            }
            if (kidsDiagram) {
              const image = document.createElement('img');
              image.className = 'progression-image';
              image.src = `/images/kids-progression/${progressionImages[stage - 1]}.webp`;
              image.alt = '';
              image.loading = 'lazy';
              image.decoding = 'async';
              sibling.prepend(image);
            }
          }
          content.push(sibling);
          sibling = sibling.nextElementSibling;
        }

        tabs.push({ heading, content });

        // Create tab button
        const label = heading.textContent || `Tab ${index + 1}`;
        const button = document.createElement('button');
        button.type = 'button';
        button.setAttribute('role', 'tab');
        button.setAttribute('aria-selected', index === 0 ? 'true' : 'false');
        button.setAttribute('aria-controls', id);
        button.className = `tab-button ${index === 0 ? 'active' : ''}`;
        button.textContent = label;
        button.onclick = () => selectTab(index);
        tabsNav.appendChild(button);
      });

      function selectTab(index: number) {
        // Update buttons
        tabsNav.querySelectorAll(`[aria-controls]`).forEach((btn) => {
          btn.setAttribute('aria-selected', 'false');
          btn.classList.remove('active');
        });
        const activeBtn = tabsNav.querySelectorAll('.tab-button')[index] as HTMLElement;
        activeBtn?.setAttribute('aria-selected', 'true');
        activeBtn?.classList.add('active');

        // Show/hide content
        tabs.forEach((tab, i) => {
          const isActive = i === index;
          tab.heading.classList.toggle('tab-hidden', !isActive);
          tab.content.forEach((el) => {
            el.classList.toggle('tab-hidden', !isActive);
          });
        });
      }

      // Initialize first tab as active
      selectTab(0);
    });
  }

  // Run on page load and when content changes
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeTabs);
  } else {
    initializeTabs();
  }
</script>

<style>
  .program-section { margin-top: var(--space-6); padding: clamp(1.15rem, 3vw, 2rem); border: 1px solid var(--color-border); border-radius: 1.6rem; background: var(--color-surface-soft); box-shadow: var(--shadow-sm); }
  .program-heading { display: flex; align-items: center; gap: .9rem; margin-bottom: 1.25rem; }
  .program-icon { display: grid; width: 3.25rem; height: 3.25rem; flex: 0 0 auto; place-items: center; border-radius: 1rem 1rem 1rem .32rem; color: #fff; background: linear-gradient(135deg, var(--zone-ink-bg), #44577d); box-shadow: 0 10px 24px rgb(25 39 69 / .18); }
  :global(:dir(rtl)) .program-icon { border-radius: 1rem 1rem .32rem 1rem; }
  .program-heading p { margin: 0 0 .15rem; color: var(--color-primary-text); font-size: .68rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  :global(:lang(ar)) .program-heading p { letter-spacing: 0; }
  .program-heading strong { color: var(--color-navy); font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.35rem); }

  .tabs-wrapper { margin-top: 1.5rem; }
  .tabs-nav { display: flex; gap: .5rem; margin-bottom: 2rem; overflow-x: auto; padding-bottom: .75rem; border-bottom: 1px solid color-mix(in srgb, var(--course-accent, var(--color-primary)) 20%, var(--color-border)); }
  .tabs-nav :global(.tab-button) { position: relative; padding: .8rem 1.35rem; border: 0; border-radius: var(--radius) var(--radius) 0 0; color: var(--color-ink); background: transparent; font-size: var(--fs-sm); font-weight: 700; font-family: var(--font-display); cursor: pointer; transition: all var(--motion-fast) var(--ease); white-space: nowrap; letter-spacing: .02em; }
  .tabs-nav :global(.tab-button:hover) { color: var(--course-accent, var(--color-primary)); background: color-mix(in srgb, var(--course-soft, var(--color-blue-soft)) 40%, transparent); }
  .tabs-nav :global(.tab-button.active) { color: var(--course-accent, var(--color-primary)); background: color-mix(in srgb, var(--course-soft, var(--color-blue-soft)) 100%, transparent); }
  .tabs-nav :global(.tab-button.active::after) { content: ''; position: absolute; bottom: -1px; inset-inline: 0; height: 3px; background: linear-gradient(90deg, var(--course-accent, var(--color-primary)), var(--color-coral)); border-radius: 3px 3px 0 0; }

  .course-prose { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; margin: 0; }
  .course-prose :global(> p) { margin: 0; padding: 1.15rem; border: 1px solid var(--color-border); border-radius: 1rem; color: var(--color-ink-muted); background: var(--color-bg-raised); box-shadow: 0 7px 20px rgb(25 39 69 / .045); }
  .course-prose :global(> .full-width-copy) { grid-column: 1 / -1; }
  .course-prose :global(> p.tab-hidden) { display: none; }
  .course-prose :global(> p:first-child) { color: var(--color-navy); background: linear-gradient(145deg, var(--color-bg-raised), rgb(182 23 51 / .035)); font-weight: 650; }
  .course-prose :global(> p.progression-card) { --progression-accent: var(--course-accent, var(--color-primary)); position: relative; min-height: 9.5rem; padding: 1.35rem 1.2rem 1.2rem 6.5rem; overflow: hidden; border-color: color-mix(in srgb, var(--progression-accent) 34%, var(--color-border)); border-radius: 1.25rem; background: linear-gradient(145deg, color-mix(in srgb, var(--progression-accent) 14%, var(--color-bg-raised)), var(--color-bg-raised)); box-shadow: 0 14px 28px color-mix(in srgb, var(--progression-accent) 9%, transparent); transition: transform var(--motion-fast) var(--ease), box-shadow var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease); }
  .course-prose :global(> p.progression-card[data-stage='1']) { --progression-accent: #1769db; }
  .course-prose :global(> p.progression-card[data-stage='2']) { --progression-accent: #00a9bf; }
  .course-prose :global(> p.progression-card[data-stage='3']) { --progression-accent: #71a900; }
  .course-prose :global(> p.progression-card[data-stage='4']) { --progression-accent: #e87800; }
  .course-prose :global(> p.progression-card[data-stage='5']) { --progression-accent: #db2841; }
  .course-prose :global(> p.progression-card[data-stage='6']) { --progression-accent: #8b28c8; }
  .course-prose :global(> p.progression-card[data-stage='7']) { --progression-accent: #5429b9; }
  .course-prose :global(> .progression-divider) { --progression-accent: var(--course-accent, var(--color-primary)); display: flex; grid-column: 1 / -1; align-items: center; gap: .7rem; margin-top: .9rem; color: var(--progression-accent); font-size: .72rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .course-prose :global(> .progression-divider.tab-hidden) { display: none; }
  .course-prose :global(> .progression-divider::before), .course-prose :global(> .progression-divider::after) { content: ''; height: 1px; flex: 1; background: color-mix(in srgb, var(--progression-accent) 32%, transparent); }
  .course-prose :global(> .progression-divider[data-stage='1']) { --progression-accent: #1769db; }
  .course-prose :global(> .progression-divider[data-stage='2']) { --progression-accent: #00a9bf; }
  .course-prose :global(> .progression-divider[data-stage='3']) { --progression-accent: #71a900; }
  .course-prose :global(> .progression-divider[data-stage='4']) { --progression-accent: #e87800; }
  .course-prose :global(> .progression-divider[data-stage='5']) { --progression-accent: #db2841; }
  .course-prose :global(> .progression-divider[data-stage='6']) { --progression-accent: #8b28c8; }
  .course-prose :global(> .progression-divider[data-stage='7']) { --progression-accent: #5429b9; }
  .course-prose :global(> p.progression-card strong) { display: block; margin-bottom: .35rem; color: var(--progression-accent); font-size: 1.02rem; }
  :global(:dir(rtl)) .program-section:not(.adult-diagram) .course-prose :global(> p.progression-card strong) { direction: ltr; text-align: right; }
  .course-prose :global(> p.progression-card .progression-image) { position: absolute; width: 4.8rem; height: 4.8rem; inset-inline-start: .85rem; top: 1.05rem; object-fit: contain; filter: drop-shadow(0 10px 12px color-mix(in srgb, var(--progression-accent) 18%, transparent)); transition: transform var(--motion-fast) var(--ease); }
  .course-prose :global(> p.progression-card::after) { content: ''; position: absolute; width: 5rem; height: 5rem; inset-inline-end: -2.5rem; bottom: -2.75rem; border-radius: 50%; background: color-mix(in srgb, var(--progression-accent) 12%, transparent); }
  .course-prose :global(> p.progression-card:hover) { transform: translateY(-3px); border-color: var(--progression-accent); box-shadow: 0 18px 34px color-mix(in srgb, var(--progression-accent) 16%, transparent); }
  .course-prose :global(> p.progression-card:hover .progression-image) { transform: translateY(-3px) rotate(-3deg) scale(1.06); }
  :global(:dir(rtl)) .course-prose :global(> p.progression-card) { padding-inline: 6.5rem 1.2rem; }
  .adult-diagram .course-prose :global(> p.progression-card) { min-height: 7rem; padding: 1.2rem; padding-inline-start: 4.2rem; }
  .adult-diagram .course-prose :global(> p.progression-card.band-end) { grid-column: 1 / -1; min-height: 5.8rem; }
  .course-prose :global(> p.progression-card[data-step]::before) { content: attr(data-step); position: absolute; inset-block-start: 1.1rem; inset-inline-start: 1rem; display: grid; width: 2.4rem; height: 2.4rem; place-items: center; border-radius: 50%; color: #fff; background: linear-gradient(145deg, var(--color-primary), var(--color-primary-deep)); box-shadow: inset 0 1px 0 rgb(255 255 255 / .35), 0 0 0 3px var(--color-bg-raised), 0 0 0 5px color-mix(in srgb, var(--color-primary) 22%, transparent), 0 8px 16px rgb(85 10 30 / .18); font-size: .85rem; font-weight: 850; }
  .kids-diagram .course-prose :global(> p.progression-card[data-step]::before) { inset-block-start: .85rem; inset-inline-start: 2.05rem; font-size: .7rem; }
  .kids-diagram .course-prose :global(> p.progression-card .progression-image) { top: 4rem; }
  .step-diagram .course-prose { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .step-diagram .course-prose :global(> p:not(.progression-card)) { grid-column: 1 / -1; }
  .step-diagram .course-prose :global(> p.progression-card) { min-height: 11rem; padding: 4.5rem 1.25rem 1.25rem; }
  .step-diagram .course-prose :global(> p.progression-card[data-step]::before) { inset-block-start: 1.15rem; inset-inline-start: 1.25rem; }
  .step-diagram .course-prose :global(> p.progression-card strong) { color: var(--color-navy); }
  .adult-diagram .course-prose :global(> p.progression-card strong) { color: var(--color-navy); }
  .adult-diagram .course-prose :global(> p.progression-card:hover) { transform: none; border-color: color-mix(in srgb, var(--progression-accent) 34%, var(--color-border)); box-shadow: 0 14px 28px color-mix(in srgb, var(--progression-accent) 9%, transparent); }
  .adult-diagram .course-prose :global(> .progression-divider) { color: var(--color-navy); font-size: .85rem; letter-spacing: .03em; }
  .course-prose :global(> h2) { grid-column: 1 / -1; margin: .65rem 0 0; padding-inline-start: .85rem; border-inline-start: 4px solid var(--color-coral); color: var(--color-navy); font-size: clamp(1.25rem, 2.5vw, 1.65rem); }
  .course-prose :global(> h3) { grid-column: 1 / -1; margin: 1.15rem 0 0; color: var(--color-navy); font-size: clamp(1rem, 2vw, 1.2rem); }
  .course-prose :global(> h2.tab-hidden) { display: none; }
  .course-prose :global(> ul), .course-prose :global(> ol) { display: grid; grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; margin: 0; padding: 0; list-style: none; }
  .course-prose :global(> ul.tab-hidden), .course-prose :global(> ol.tab-hidden) { display: none; }
  .course-prose :global(> ul > li), .course-prose :global(> ol > li) { position: relative; min-height: 3.4rem; padding-block: .85rem; padding-inline: 2.6rem .9rem; border: 1px solid var(--color-border); border-radius: .9rem; color: var(--color-navy); background: var(--color-bg-raised); font-size: .9rem; font-weight: 650; }
  .course-prose :global(> ul > li.tab-hidden), .course-prose :global(> ol > li.tab-hidden) { display: none; }
  .course-prose :global(> ul > li::before), .course-prose :global(> ol > li::before) { content: '✓'; position: absolute; display: grid; width: 1.55rem; height: 1.55rem; place-items: center; inset-inline-start: .7rem; top: .78rem; border-radius: .48rem; color: #fff; background: linear-gradient(135deg, var(--color-primary), var(--color-coral)); font-size: .72rem; font-weight: 900; }
  @media (max-width: 620px) {
    .tabs-nav { gap: .35rem; margin-bottom: 1.5rem; }
    .tabs-nav :global(.tab-button) { padding: .7rem 1.1rem; font-size: clamp(.8rem, 2vw, .9rem); }
    .course-prose { grid-template-columns: 1fr; }
    .course-prose :global(> p), .course-prose :global(> h2), .course-prose :global(> h3), .course-prose :global(> ul), .course-prose :global(> ol) { grid-column: 1; }
    .course-prose :global(> ul), .course-prose :global(> ol) { grid-template-columns: 1fr; }
    .step-diagram .course-prose { grid-template-columns: 1fr; }
    .step-diagram .course-prose :global(> p.progression-card) { min-height: 8rem; }
  }
  .course-prose :global(> .tab-hidden) { display: none; }
</style>
