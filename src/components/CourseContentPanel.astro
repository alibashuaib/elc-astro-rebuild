---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  Content: any;
}

const { locale, Content } = Astro.props;
const isArabic = locale === 'ar';
---

<section class="program-section" aria-label={isArabic ? 'تفاصيل البرنامج' : 'Program details'}>
  <header class="program-heading">
    <span class="program-icon"><Icon name="details" size={24} /></span>
    <div>
      <p>{isArabic ? 'داخل البرنامج' : 'Inside the program'}</p>
      <strong>{isArabic ? 'تجربة تعليمية واضحة ومنظمة' : 'A clear, structured learning experience'}</strong>
    </div>
  </header>
  <div class="prose course-prose">
    <Content />
  </div>
</section>

<style>
  .program-section { margin-top: var(--space-6); padding: clamp(1.15rem, 3vw, 2rem); border: 1px solid var(--color-border); border-radius: 1.6rem; background: var(--color-surface-soft); box-shadow: var(--shadow-sm); }
  .program-heading { display: flex; align-items: center; gap: .9rem; margin-bottom: 1.25rem; }
  .program-icon { display: grid; width: 3.25rem; height: 3.25rem; flex: 0 0 auto; place-items: center; border-radius: 1rem 1rem 1rem .32rem; color: #fff; background: linear-gradient(135deg, var(--zone-ink-bg), #44577d); box-shadow: 0 10px 24px rgb(25 39 69 / .18); }
  :global(:dir(rtl)) .program-icon { border-radius: 1rem 1rem .32rem 1rem; }
  .program-heading p { margin: 0 0 .15rem; color: var(--color-primary-text); font-size: .68rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  :global(:lang(ar)) .program-heading p { letter-spacing: 0; }
  .program-heading strong { color: var(--color-navy); font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.35rem); }
  .course-prose { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; margin: 0; }
  .course-prose :global(> p) { margin: 0; padding: 1.15rem; border: 1px solid var(--color-border); border-radius: 1rem; color: var(--color-ink-muted); background: var(--color-bg-raised); box-shadow: 0 7px 20px rgb(25 39 69 / .045); }
  .course-prose :global(> p:first-child) { color: var(--color-navy); background: linear-gradient(145deg, var(--color-bg-raised), rgb(182 23 51 / .035)); font-weight: 650; }
  .course-prose :global(> h2) { grid-column: 1 / -1; margin: .65rem 0 0; padding-inline-start: .85rem; border-inline-start: 4px solid var(--color-coral); color: var(--color-navy); font-size: clamp(1.25rem, 2.5vw, 1.65rem); }
  .course-prose :global(> ul), .course-prose :global(> ol) { display: grid; grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; margin: 0; padding: 0; list-style: none; }
  .course-prose :global(> ul > li), .course-prose :global(> ol > li) { position: relative; min-height: 3.4rem; padding-block: .85rem; padding-inline: 2.6rem .9rem; border: 1px solid var(--color-border); border-radius: .9rem; color: var(--color-navy); background: var(--color-bg-raised); font-size: .9rem; font-weight: 650; }
  .course-prose :global(> ul > li::before), .course-prose :global(> ol > li::before) { content: '✓'; position: absolute; display: grid; width: 1.55rem; height: 1.55rem; place-items: center; inset-inline-start: .7rem; top: .78rem; border-radius: .48rem; color: #fff; background: linear-gradient(135deg, var(--color-primary), var(--color-coral)); font-size: .72rem; font-weight: 900; }
  @media (max-width: 620px) {
    .course-prose { grid-template-columns: 1fr; }
    .course-prose :global(> p), .course-prose :global(> h2), .course-prose :global(> ul), .course-prose :global(> ol) { grid-column: 1; }
    .course-prose :global(> ul), .course-prose :global(> ol) { grid-template-columns: 1fr; }
  }
</style>
