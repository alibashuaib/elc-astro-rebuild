---
import { useTranslations, localizePath, type Locale } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const brandName = locale === 'ar' ? 'معهد صرح المعرفة' : 'ELC';
const copyright = locale === 'ar'
  ? `© ${year} معهد صرح المعرفة. جميع الحقوق محفوظة.`
  : `© ${year} ELC. All rights reserved.`;

// Real contact/social details, pulled from the live elc.com.sa.
const socialLinks = [
  { label: 'X (Twitter)', href: 'https://twitter.com/elcjeddah', icon: 'x' },
  { label: 'Instagram', href: 'https://www.instagram.com/elcjeddah', icon: 'instagram' },
  { label: 'Snapchat', href: 'https://www.snapchat.com/add/elcjeddah', icon: 'snapchat' },
  { label: 'YouTube', href: 'https://www.youtube.com/c/ELCInst', icon: 'youtube' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <strong>{brandName}</strong>
      <p>{copyright}</p>
      <p>
        <a class="numeric" href="tel:+966591799917">+966 59 179 9917</a>
        &nbsp;·&nbsp;
        <a href="mailto:info@elc.com.sa">info@elc.com.sa</a>
      </p>
    </div>
    <nav class="social-nav" aria-label={locale === 'ar' ? 'وسائل التواصل الاجتماعي' : 'Social media'}>
      {socialLinks.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
          {s.icon === 'facebook' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.19 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.09 0 2.23.2 2.23.2v2.47H15.2c-1.24 0-1.63.77-1.63 1.57v1.88h2.77l-.44 2.91h-2.33V22C18.34 21.25 22 17.08 22 12.06Z" /></svg>
          )}
          {s.icon === 'x' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.36l7.26-8.3L2.98 2h6.4l4.42 5.84L18.9 2Zm-1.1 17.84h1.73L8.44 4.05H6.58L17.8 19.84Z" /></svg>
          )}
          {s.icon === 'instagram' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6Zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" /></svg>
          )}
          {s.icon === 'snapchat' && (
            <svg class="snapchat-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C9 3 7 5.2 7 8.2v3c0 1.2-.8 2.1-2 2.5.8.9 1.8 1.4 3 1.6.2 1.7 1.1 2.3 2.5 1.6.9-.4 1.9-.4 3 0 1.4.7 2.3.1 2.5-1.6 1.2-.2 2.2-.7 3-1.6-1.2-.4-2-1.3-2-2.5v-3C17 5.2 15 3 12 3Z" /></svg>
          )}
          {s.icon === 'youtube' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a2.999 2.999 0 0 0-2.112-2.12C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.386.521a2.999 2.999 0 0 0-2.112 2.12C0 8.07 0 12 0 12s0 3.93.502 5.814a2.999 2.999 0 0 0 2.112 2.12c1.881.521 9.386.521 9.386.521s7.505 0 9.386-.521a2.999 2.999 0 0 0 2.112-2.12C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.75 15.568V8.432L15.818 12 9.75 15.568Z" /></svg>
          )}
          {s.icon === 'linkedin' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14ZM8.27 18.5V10.13H5.5v8.37h2.77Zm-1.39-9.94a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68ZM18.5 18.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79Z" /></svg>
          )}
          <span class="sr-only">{s.label}</span>
        </a>
      ))}
    </nav>
    <nav class="legal-nav" aria-label={locale === 'ar' ? 'روابط قانونية' : 'Legal'}>
      <a href={localizePath(locale, '/legal/terms')}>{t('footer.terms')}</a>
      <a href={localizePath(locale, '/legal/privacy')}>{t('footer.privacy')}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 0;
    margin-top: var(--space-7);
    padding-block: var(--space-6);
    color: #c4c1bd;
    background: #242529;
    font-size: var(--fs-sm);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .footer-inner strong { color: #fff; font-family: var(--font-display); font-size: 1.35rem; }
  .footer-inner p { margin: var(--space-1) 0 0; color: #c4c1bd; }
  .footer-inner p a { color: #dedbd7; }
  :global(.legal-nav a) {
    color: #dedbd7;
    margin-inline-end: var(--space-3);
  }
  :global(.social-nav) { display: flex; align-items: center; gap: .55rem; }
  :global(.social-nav a) {
    display: grid;
    place-items: center;
    width: 2.65rem;
    height: 2.65rem;
    border: 1px solid #4c4e53;
    border-radius: 999px;
    color: #dedbd7;
    background: #2d2f33;
    transition: transform var(--motion-fast) var(--ease), color var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease), background-color var(--motion-fast) var(--ease);
  }
  :global(.social-nav a:hover) {
    color: #fff;
    border-color: var(--color-coral);
    background: var(--color-primary);
    text-decoration: none;
    transform: translateY(-2px);
  }
  :global(.social-nav svg) { width: 1.15rem; height: 1.15rem; fill: currentColor; }
  :global(.social-nav .snapchat-icon) { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .footer-inner a:hover { color: #fff; }
</style>
