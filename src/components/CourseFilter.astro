---
// Client-side category filter for the courses hub. All cards render server-side
// regardless of JS state (so content stays fully crawlable and works with JS off —
// filtering is a progressive enhancement, not a requirement to see the catalog).
import { categoryLabels, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  categories: string[]; // distinct categories actually present in this locale's courses
}
const { locale, categories } = Astro.props;
const t = useTranslations(locale);
const labels = categoryLabels[locale];
---

<div class="course-filter" role="group" aria-label={t('courses.filterAll')}>
  <button type="button" class="filter-chip is-active" data-filter="all">{t('courses.filterAll')}</button>
  {categories.map((cat) => (
    <button type="button" class="filter-chip" data-filter={cat}>{labels[cat]}</button>
  ))}
</div>
<p class="no-results" hidden>{t('courses.noResults')}</p>

<style>
  .course-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .filter-chip {
    font: inherit;
    font-weight: 600;
    padding: .55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-raised);
    color: var(--color-ink);
    cursor: pointer;
  }
  .filter-chip:hover { border-color: var(--color-primary); color: var(--color-primary-text); }
  .filter-chip.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
    box-shadow: 0 8px 20px rgb(182 23 51 / .2);
  }
  .no-results { color: var(--color-ink-muted); margin-top: var(--space-4); }
</style>

<script>
  const filterEl = document.querySelector('.course-filter');
  const cards = document.querySelectorAll<HTMLElement>('.course-grid [data-category]');
  const noResults = document.querySelector<HTMLElement>('.no-results');

  filterEl?.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>('.filter-chip');
    if (!chip) return;
    filterEl.querySelectorAll('.filter-chip').forEach((c) => c.classList.toggle('is-active', c === chip));
    let visible = 0;
    cards.forEach((card) => {
      card.hidden = chip.dataset.filter !== 'all' && card.dataset.category !== chip.dataset.filter;
      if (!card.hidden) visible++;
    });
    if (noResults) noResults.hidden = visible > 0;
  });
</script>
