---
// Signature hero visual — the CEFR A1→C2 progression as an ascending line,
// echoing the logo's arrow motif (plan §4: "actual content... not decoration").
// Pure inline SVG: no image weight, themes automatically via CSS custom properties.
interface Props {
  locale: 'en' | 'ar';
  /** 'paper' (default) reads on the light/dark-mode-aware page background;
   *  'ink' reads on the fixed .zone-ink editorial band regardless of OS theme. */
  tone?: 'paper' | 'ink';
}
const { locale, tone = 'paper' } = Astro.props;
const levels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];

// Steps upward left-to-right in the SVG's own coordinate space; for Arabic the
// whole progression is mirrored horizontally (reading direction), but each
// point keeps its own upright <text> label — no CSS-mirror hack that would
// also flip the text backwards.
const ltrPoints: [number, number][] = [
  [20, 220], [76, 186], [132, 156], [188, 118], [238, 82], [278, 50],
];
const points = locale === 'ar' ? ltrPoints.map(([x, y]) => [320 - x, y] as [number, number]) : ltrPoints;

const path = points.map((p, i) => (i === 0 ? `M${p[0]},${p[1]}` : `L${p[0]},${p[1]}`)).join(' ');
const last = points[points.length - 1];
const prev = points[points.length - 2];

// Arrowhead: a clean filled triangle, angled along the final line segment and
// placed just past the last point so it never overlaps the endpoint dot.
const angle = Math.atan2(last[1] - prev[1], last[0] - prev[0]);
const tipDist = 22;
const tipX = last[0] + Math.cos(angle) * tipDist;
const tipY = last[1] + Math.sin(angle) * tipDist;
const wing = 7;
const leftX = tipX - Math.cos(angle) * 14 + Math.cos(angle + Math.PI / 2) * wing;
const leftY = tipY - Math.sin(angle) * 14 + Math.sin(angle + Math.PI / 2) * wing;
const rightX = tipX - Math.cos(angle) * 14 + Math.cos(angle - Math.PI / 2) * wing;
const rightY = tipY - Math.sin(angle) * 14 + Math.sin(angle - Math.PI / 2) * wing;
const arrowPolygon = `${tipX},${tipY} ${leftX},${leftY} ${rightX},${rightY}`;
---

<div class={`hero-graphic tone-${tone}`} role="img" aria-label="Course levels rising from A1 beginner to C2 proficient">
  <svg viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id={`heroBlob-${locale}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--color-crimson)" stop-opacity="0.16" />
        <stop offset="100%" stop-color="var(--color-amber-text)" stop-opacity="0.16" />
      </linearGradient>
    </defs>

    <path
      d="M40 40 Q -10 130 60 200 Q 140 270 230 220 Q 320 170 290 90 Q 265 15 170 20 Q 90 25 40 40 Z"
      fill={`url(#heroBlob-${locale})`}
    />

    <path d={path} class="climb-line" fill="none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />

    {points.slice(0, -1).map((p) => (
      <circle cx={p[0]} cy={p[1]} r="6" class="dot" stroke-width="2.5" />
    ))}
    <circle cx={last[0]} cy={last[1]} r="9" class="dot dot-final" stroke-width="2.5" />

    <polygon points={arrowPolygon} class="arrowhead" />

    {points.map((p, i) => (
      <text x={p[0]} y={p[1] - 16} text-anchor="middle" class="level-label">{levels[i]}</text>
    ))}
  </svg>
</div>

<style>
  .hero-graphic {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 320 / 260;
  }
  .hero-graphic svg { width: 100%; height: 100%; overflow: visible; }
  /* Local override, scoped to this element only — lets the same graphic read
     correctly on the fixed ink zone regardless of the visitor's OS theme. */
  .hero-graphic.tone-ink {
    --color-crimson-text: var(--zone-ink-signal);
    --color-crimson: var(--zone-ink-signal);
    --color-bg-raised: var(--zone-ink-bg);
  }
  .climb-line { stroke: var(--color-crimson-text); }
  .dot { fill: var(--color-bg-raised); stroke: var(--color-crimson-text); }
  .dot-final { fill: var(--color-crimson); }
  .arrowhead { fill: var(--color-crimson); }
  .level-label {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    fill: var(--color-crimson-text);
  }
</style>
