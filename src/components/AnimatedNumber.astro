---
interface Props {
  value: string;
  class?: string;
}

const { value, class: className } = Astro.props;
const compactValue = value.replace(/,/g, '');
const match = compactValue.match(/^(\D*)(\d+(?:\.\d+)?)(\D*)$/);
const prefix = match?.[1] ?? '';
const target = Number(match?.[2] ?? 0);
const suffix = match?.[3] ?? '';
---

<strong
  class:list={['number-reveal', className]}
  data-count-up
  data-prefix={prefix}
  data-target={target}
  data-suffix={suffix}
  aria-label={value}
><span aria-hidden="true">{value}</span></strong>

<script>
  const selector = '[data-count-up]:not([data-count-ready])';
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const animateNumber = (element: HTMLElement) => {
    if (element.dataset.counted === 'true') return;
    element.dataset.counted = 'true';

    const output = element.querySelector('span');
    const target = Number(element.dataset.target ?? 0);
    const prefix = element.dataset.prefix ?? '';
    const suffix = element.dataset.suffix ?? '';
    const formatter = new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 });

    if (!output || prefersReducedMotion.matches || !Number.isFinite(target)) return;

    const startValue = target >= 1900 && target <= 2100 ? target - 10 : 0;
    const duration = 1150;
    const startTime = performance.now();

    const tick = (now: number) => {
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 4);
      const currentValue = Math.round(startValue + (target - startValue) * eased);
      const formattedValue = target >= 1900 && target <= 2100
        ? String(currentValue)
        : formatter.format(currentValue);
      output.textContent = `${prefix}${formattedValue}${suffix}`;

      if (progress < 1) requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  };

  const numbers = Array.from(document.querySelectorAll<HTMLElement>(selector));
  numbers.forEach((number) => { number.dataset.countReady = 'true'; });

  if ('IntersectionObserver' in window && !prefersReducedMotion.matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        animateNumber(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.45 });

    numbers.forEach((number) => observer.observe(number));
  } else {
    numbers.forEach(animateNumber);
  }
</script>

<style>
  .number-reveal span { display: inline-block; }

  @media (prefers-reduced-motion: no-preference) {
    .number-reveal span { animation: number-arrive .7s var(--ease) both; }
  }

  @keyframes number-arrive {
    from { opacity: 0; transform: translateY(.45em) scale(.94); filter: blur(4px); }
    to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }
</style>
