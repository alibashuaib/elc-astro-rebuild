---
import { useTranslations, localizePath, type Locale } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const indexUrl = localizePath(locale, '/search-index.json');
---

<button type="button" class="search-toggle" data-search-open aria-label={t('search.toggle')}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
</button>

<div class="search-overlay" data-search-overlay hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label={t('search.toggle')}>
    <div class="search-input-row">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <input type="text" data-search-input placeholder={t('search.placeholder')} autocomplete="off" />
      <button type="button" class="search-close" data-search-close aria-label={t('search.toggle')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
    <ul class="search-results" data-search-results></ul>
  </div>
</div>

<script define:vars={{ indexUrl, noResults: t('search.noResults') }}>
  (function () {
    const openBtn = document.querySelector('[data-search-open]');
    const overlay = document.querySelector('[data-search-overlay]');
    const closeBtn = document.querySelector('[data-search-close]');
    const input = document.querySelector('[data-search-input]');
    const results = document.querySelector('[data-search-results]');
    if (!openBtn || !overlay || !closeBtn || !input || !results) return;

    let index = null;
    let loaded = false;

    async function ensureIndex() {
      if (loaded) return;
      loaded = true;
      try {
        const res = await fetch(indexUrl);
        index = await res.json();
      } catch (e) {
        index = [];
      }
    }

    function render(query) {
      const q = query.trim().toLowerCase();
      if (!q) { results.innerHTML = ''; return; }
      const matches = (index || []).filter((item) =>
        item.title.toLowerCase().includes(q) || item.summary.toLowerCase().includes(q)
      ).slice(0, 8);

      if (matches.length === 0) {
        results.innerHTML = `<li class="search-empty">${noResults}</li>`;
        return;
      }
      results.innerHTML = matches.map((item) => `
        <li>
          <a href="${item.url}">
            <span class="search-tag">${item.tag}</span>
            <strong>${item.title}</strong>
            <span class="search-summary">${item.summary}</span>
          </a>
        </li>
      `).join('');
    }

    async function open() {
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      await ensureIndex();
      input.focus();
    }
    function close() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      input.value = '';
      results.innerHTML = '';
    }

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) close();
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); overlay.hidden ? open() : close(); }
    });
    input.addEventListener('input', () => render(input.value));
  })();
</script>

<style>
  .search-toggle {
    display: grid;
    place-items: center;
    width: 2.65rem;
    height: 2.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0;
    color: var(--color-ink-muted);
    background: var(--color-bg-raised);
    box-shadow: 0 7px 18px rgb(49 43 40 / .08);
    cursor: pointer;
    transition: transform var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease), color var(--motion-fast) var(--ease);
  }
  .search-toggle:hover { color: var(--color-primary); border-color: rgb(182 23 51 / .34); transform: translateY(-2px); }
  .search-toggle svg { width: 1.15rem; height: 1.15rem; }

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 10vh var(--space-4) var(--space-4);
    background: rgb(20 18 17 / .55);
    backdrop-filter: blur(4px);
  }
  .search-panel {
    width: 100%;
    max-width: 34rem;
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-md);
  }
  .search-input-row {
    display: flex;
    align-items: center;
    gap: .7rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .search-input-row svg { flex-shrink: 0; width: 1.15rem; height: 1.15rem; color: var(--color-ink-muted); }
  .search-input-row input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--color-ink);
    font-size: 1rem;
    font-family: var(--font-body);
  }
  .search-close {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 0;
    border-radius: 50%;
    padding: 0;
    color: var(--color-ink-muted);
    background: var(--color-surface-soft);
    cursor: pointer;
  }
  .search-close svg { width: .9rem; height: .9rem; }
  .search-results { list-style: none; margin: 0; padding: .5rem; overflow-y: auto; }
  .search-results li + li { margin-top: .25rem; }
  .search-results a {
    display: flex;
    flex-direction: column;
    gap: .2rem;
    padding: .7rem .85rem;
    border-radius: .85rem;
    text-decoration: none;
  }
  .search-results a:hover { background: var(--color-surface-soft); text-decoration: none; }
  .search-tag { align-self: flex-start; padding: .1rem .55rem; border-radius: 999px; color: var(--color-primary); background: var(--color-blue-soft); font-size: .68rem; font-weight: 750; text-transform: uppercase; letter-spacing: .04em; }
  .search-results strong { color: var(--color-navy); font-size: .95rem; }
  .search-summary { color: var(--color-ink-muted); font-size: .82rem; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .search-empty { padding: 1.2rem .85rem; color: var(--color-ink-muted); font-size: .88rem; text-align: center; }
</style>
