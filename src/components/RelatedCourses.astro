---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  currentSlug?: string;
  title?: string;
  subtitle?: string;
}

const { locale, currentSlug, title, subtitle } = Astro.props;
const isArabic = locale === 'ar';

// Related course recommendations by category — progression and skill-building paths
const relatedBySlug: Record<string, { title: string; slug: string; description: string }[]> = {
  'kids-general': [
    {
      title: isArabic ? 'إنجليزي عام للكبار' : 'Adult General English',
      slug: 'adults-general',
      description: isArabic ? 'الخطوة التالية من تعليم الأطفال' : 'Next level after kids course',
    },
  ],
  'adults-general': [
    {
      title: isArabic ? 'إنجليزي الأعمال' : 'Business English',
      slug: 'business-english',
      description: isArabic ? 'طبّق مهاراتك في الحياة المهنية' : 'Apply skills to career',
    },
    {
      title: isArabic ? 'تحضير IELTS' : 'IELTS Preparation',
      slug: 'ielts-preparation',
      description: isArabic ? 'استعد للامتحان باستخدام مهاراتك الحالية' : 'Prepare for IELTS exam',
    },
  ],
  'ielts-preparation': [
    {
      title: isArabic ? 'إنجليزي عام للكبار' : 'Adult General English',
      slug: 'adults-general',
      description: isArabic ? 'أساس قوي قبل التحضير للاختبار' : 'Strong foundation before exam prep',
    },
    {
      title: isArabic ? 'تحضير الجامعة' : 'University Exam Prep',
      slug: 'university-exam-prep',
      description: isArabic ? 'تحضير شامل للاختبارات الجامعية' : 'Complete university entrance prep',
    },
  ],
  'business-english': [
    {
      title: isArabic ? 'إنجليزي عام للكبار' : 'Adult General English',
      slug: 'adults-general',
      description: isArabic ? 'أساس الثقة في التواصل' : 'Foundation for confident communication',
    },
  ],
  'step-exam-preparation': [
    {
      title: isArabic ? 'إنجليزي عام للكبار' : 'Adult General English',
      slug: 'adults-general',
      description: isArabic ? 'قوّ أساسياتك قبل التحضير للاختبار' : 'Build strong foundation before STEP',
    },
  ],
  'university-exam-prep': [
    {
      title: isArabic ? 'تحضير IELTS' : 'IELTS Preparation',
      slug: 'ielts-preparation',
      description: isArabic ? 'خيار بديل للاختبارات الدولية' : 'Alternative for international exams',
    },
  ],
  'womens-general-english': [
    {
      title: isArabic ? 'إنجليزي الأعمال' : 'Business English',
      slug: 'business-english',
      description: isArabic ? 'الخطوة التالية في رحلتك المهنية' : 'Next step in your career journey',
    },
  ],
};

const courses = currentSlug && relatedBySlug[currentSlug] ? relatedBySlug[currentSlug] : [];

if (!courses.length) {
  export const Fragment = undefined;
}
---

{courses.length > 0 && (
  <aside class="related-courses" aria-label={isArabic ? "دورات ذات صلة" : "Related courses"}>
    <h3 class="related-title">
      {title || (isArabic ? 'الخطوة التالية في رحلتك' : 'Your Next Learning Step')}
    </h3>
    {subtitle && <p class="related-subtitle">{subtitle}</p>}

    <div class="related-grid">
      {courses.map(course => (
        <a href={`/${locale}/courses/${course.slug}/`} class="course-link">
          <span class="course-icon">→</span>
          <div class="course-info">
            <strong class="course-name">{course.title}</strong>
            <p class="course-desc">{course.description}</p>
          </div>
        </a>
      ))}
    </div>
  </aside>
)}

<style>
  .related-courses {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--zone-base-raised);
    border-radius: 0.75rem;
    border-left: 4px solid var(--brand-primary);
  }

  .related-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
  }

  .related-subtitle {
    font-size: 0.875rem;
    margin: 0 0 1rem 0;
    opacity: 0.7;
  }

  .related-grid {
    display: grid;
    gap: 0.75rem;
  }

  .course-link {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1rem;
    background: var(--color-base);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    border: 1px solid var(--border-subtle);
  }

  .course-link:hover {
    background: var(--zone-base-raised);
    border-color: var(--brand-primary);
    transform: translateX(4px);
  }

  .course-icon {
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    color: var(--brand-primary);
    min-width: 2rem;
  }

  .course-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .course-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .course-desc {
    font-size: 0.8rem;
    margin: 0;
    opacity: 0.65;
  }

  @media (max-width: 599px) {
    .related-courses {
      margin: 1.5rem 0;
      padding: 1rem;
      border-left-width: 3px;
    }

    .related-title {
      font-size: 1rem;
    }

    .course-link {
      padding: 0.75rem;
      gap: 0.75rem;
    }

    .course-name {
      font-size: 0.9rem;
    }

    .course-desc {
      font-size: 0.75rem;
    }
  }
</style>
