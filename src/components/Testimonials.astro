---
import type { GoogleReviewsResult } from '../lib/googleReviews';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  data: GoogleReviewsResult | null;
}
const { locale, data } = Astro.props;
const t = useTranslations(locale);

function stars(rating: number) {
  return '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating));
}
---

{/* Rating badge alone is enough to render — Places API can return the
    aggregate (rating/count) without individual review text, e.g. while
    Enterprise+Atmosphere-tier access is still being sorted out. The quote
    cards only appear once real review text actually comes back. The
    official multicolor "G" mark identifies these as real Google reviews —
    standard, expected use for a review widget citing its source. */}
{data && data.overallRating > 0 && (
  <section class="testimonials">
    <div class="testimonials-head">
      <h2>{t('testimonials.title')}</h2>

      <div class="google-rating-card">
        <svg class="google-g" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20c11.045 0 20-8.955 20-20 0-1.341-.138-2.65-.389-3.917Z"/>
          <path fill="#FF3D00" d="m6.306 14.691 6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691Z"/>
          <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44Z"/>
          <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a11.965 11.965 0 0 1-4.087 5.571l6.19 5.238C40.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917Z"/>
        </svg>
        <div class="google-rating-body">
          <div class="google-rating-top">
            <span class="numeric">{data.overallRating.toFixed(1)}</span>
            <span class="stars" aria-hidden="true">{stars(data.overallRating)}</span>
          </div>
          <p class="google-rating-sub">
            <span class="google-label">{t('testimonials.googleReviews')}</span>
            <span class="dot" aria-hidden="true">·</span>
            <span class="numeric">{data.totalReviewCount}</span> {t('testimonials.reviews')}
          </p>
        </div>
      </div>
    </div>

    {data.reviews.length > 0 && (
      <div class="testimonial-grid">
        {/* Google's Places API never returns more than 5 reviews per place
            regardless of tier — this slice just makes that limit explicit
            rather than relying on the API to always cap it for us. */}
        {data.reviews.slice(0, 5).map((review) => (
          <blockquote class="testimonial-card">
            <svg class="card-g" viewBox="0 0 48 48" aria-hidden="true">
              <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20c11.045 0 20-8.955 20-20 0-1.341-.138-2.65-.389-3.917Z"/>
              <path fill="#FF3D00" d="m6.306 14.691 6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691Z"/>
              <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44Z"/>
              <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a11.965 11.965 0 0 1-4.087 5.571l6.19 5.238C40.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917Z"/>
            </svg>
            <p class="stars" aria-label={`${review.rating} / 5`}>{stars(review.rating)}</p>
            <p class="quote">{review.text}</p>
            <footer>
              <cite>{review.authorName}</cite>
              <span class="time">{review.relativeTime}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    )}

    <a
      href="https://www.google.com/maps/search/?api=1&query=ELC"
      target="_blank"
      rel="noopener"
      class="btn btn-outline view-all-link"
    >
      <svg class="btn-g" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20c11.045 0 20-8.955 20-20 0-1.341-.138-2.65-.389-3.917Z"/>
        <path fill="#FF3D00" d="m6.306 14.691 6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691Z"/>
        <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44Z"/>
        <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a11.965 11.965 0 0 1-4.087 5.571l6.19 5.238C40.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917Z"/>
      </svg>
      {t('testimonials.viewAll')}
    </a>
  </section>
)}

<style>
  .testimonials { margin-top: var(--space-7); }
  .testimonials-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .testimonials-head h2 { margin: 0; }

  .google-rating-card {
    display: flex;
    align-items: center;
    gap: .9rem;
    padding: .85rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .google-g { flex-shrink: 0; width: 1.9rem; height: 1.9rem; }
  .google-rating-top { display: flex; align-items: baseline; gap: .4rem; }
  .google-rating-top .numeric { color: var(--color-navy); font-size: 1.4rem; font-weight: 850; line-height: 1; }
  .stars { color: var(--color-amber-text); letter-spacing: 0.1em; margin: 0; font-size: .95rem; }
  .google-rating-sub { margin: .1rem 0 0; color: var(--color-ink-muted); font-size: var(--fs-sm); }
  .google-label { font-weight: 650; color: var(--color-ink); }
  .google-rating-sub .dot { margin: 0 .2rem; color: var(--color-border-strong); }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .testimonial-card {
    position: relative;
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-sm);
    transition: transform var(--motion-base) var(--ease), box-shadow var(--motion-base) var(--ease);
  }
  .testimonial-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .card-g { position: absolute; inset-inline-end: 1rem; top: 1rem; width: 1.2rem; height: 1.2rem; opacity: .85; }
  .quote { color: var(--color-ink); margin: var(--space-2) 2rem var(--space-2) 0; }
  .testimonial-card footer {
    display: flex;
    justify-content: space-between;
    font-size: var(--fs-sm);
    color: var(--color-ink-muted);
  }
  cite { font-style: normal; font-weight: 600; color: var(--color-ink); }

  .view-all-link { display: inline-flex; align-items: center; gap: .55rem; }
  .btn-g { width: 1.1rem; height: 1.1rem; flex-shrink: 0; }

  @media (max-width: 560px) {
    .testimonials-head { align-items: flex-start; }
    .google-rating-card { width: 100%; }
  }
</style>
