# Security headers — fixes the audit's #1 technical gap ("no security headers at all").
# Hostinger shared hosting runs Apache, so this is the equivalent of setting them at
# the CDN/hosting level per the plan (§5).

<IfModule mod_headers.c>
  # Force HTTPS for a year, including subdomains, and allow HSTS preload list submission.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # This site is never meant to be framed by another site.
  Header always set X-Frame-Options "DENY"

  # Stop MIME-sniffing turning a text response into executable content.
  Header always set X-Content-Type-Options "nosniff"

  # Don't leak the full referring URL to third parties; keep it on same-origin navigations.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # No device/browser APIs this static marketing site has any business touching.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content-Security-Policy: allow self + the Google Fonts origins actually used,
  # + Decap CMS's CDN script on /admin, + wa.me for the WhatsApp button, + the
  # CMS OAuth Worker origin for /admin's popup flow. Update *.workers.dev to the
  # real deployed Worker origin once known, and drop 'unsafe-inline' on style-src
  # if Astro's scoped styles ever move to external files instead of <style> tags.
  #
  # 'unsafe-inline' on script-src: the site already ships literal inline
  # <script> tags (AnimatedNumber's count-up, the WhatsApp registration
  # handler, now the consent banner + GTM loader) with no nonce/hash scheme —
  # without this they'd silently fail under real CSP enforcement even though
  # they work in local preview (Vite's dev/preview server doesn't apply
  # .htaccess, so this class of bug won't show up until it's actually live).
  # Static site, no user-generated content reaching script context, so the
  # added XSS surface is low; matches the pragmatism already applied to
  # style-src below.
  #
  # googletagmanager.com covers GTM's script + the consent banner's noscript
  # iframe; google-analytics.com/analytics.google.com covers whatever GTM
  # container gets built (GA4 and/or Ads conversion pings with hashed
  # parameters) — nothing on any of these origins loads or fires until
  # PUBLIC_GTM_ID is set AND the visitor accepts (Consent Mode v2, denied by
  # default — see ConsentHead.astro).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://api.github.com https://*.workers.dev https://www.google-analytics.com https://analytics.google.com; frame-src 'self' https://www.google.com https://www.googletagmanager.com; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# Directory listing off.
Options -Indexes

# “Why ELC” now lives inside About; keep existing bookmarks and search links valid.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^en/why-elc/?$ /en/about/ [R=301,L]
  RewriteRule ^ar/why-elc/?$ /ar/about/ [R=301,L]
</IfModule>

# Standard Astro `format: "directory"` output — Apache serves /foo/index.html for /foo/ already;
# this just makes /foo (no trailing slash) resolve the same way.
DirectorySlash On

# Branded, bilingual 404 (src/pages/404.astro) instead of Apache's bare default
# error page. A single page, not per-locale — ErrorDocument can't route by the
# broken URL's language, so it shows both EN and AR with a link to each home.
ErrorDocument 404 /404.html
