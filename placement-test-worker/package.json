{
  "name": "placement-test-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --var LOCAL_DEV:true",
    "dev:fallback": "vite build --config scripts/vite.local.config.ts && node .local-dev/server.mjs",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply placement-test --local",
    "db:migrate:remote": "wrangler d1 migrations apply placement-test --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "better-sqlite3": "^13.0.3",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "bcryptjs": "latest"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
