# Copy to .env for local `npm run dev`/`npm run build`. Never commit the real .env.
# All optional — the site builds fine without them, it just skips that feature.

# A Places API (New) key, restricted to that API only.
GOOGLE_PLACES_API_KEY=

# This business's Google Place ID. Find it at:
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=

# Google Tag Manager container ID (GTM-XXXXXXX). Must be PUBLIC_-prefixed —
# Astro only exposes PUBLIC_ vars to client-side code, and the consent banner
# + GTM loader run in the browser. Nothing loads/fires until this is set —
# see ConsentHead.astro / ConsentBanner.astro (Consent Mode v2, denied by
# default until the visitor accepts).
PUBLIC_GTM_ID=

# Base URL of the deployed placement-test-worker. CI/deploy set this themselves
# (see .github/workflows/); this is only for local `npm run dev`/`npm run build`.
PUBLIC_PLACEMENT_API_URL=https://placement-test-worker.alibashuaib90.workers.dev
